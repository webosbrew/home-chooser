#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Watch the chosen Home app and restore stock policy on removal or uninstall.
# The runner stages this script and its sourced helpers in /tmp/homechooser-runtime.

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
. "$SCRIPT_DIR/lib/common.sh"

CHOICE=${HOMECHOOSER_CHOICE:-$HC_STATE_DIR/home}
LUNA=${HOMECHOOSER_LUNA_SEND:-luna-send}
LOG=${HOMECHOOSER_WATCH_LOG:-/tmp/homechooser-home.log}
OSRELEASE=${HOMECHOOSER_OSRELEASE:-/etc/os-release}
OVERRIDE=${HOMECHOOSER_OVERRIDE:-/var/webos-profile/override/org.webosbrew.homechooser.json}
MIN_INTERVAL=${HOMECHOOSER_MIN_INTERVAL:-10}
BACKOFF_CAP=${HOMECHOOSER_BACKOFF_CAP:-300}
LOG_MAX=${HOMECHOOSER_LOG_MAX:-65536}
CLOCK=${HOMECHOOSER_CLOCK:-}
SLEEP=${HOMECHOOSER_SLEEP:-sleep}
TMP=${HOMECHOOSER_TMP:-/tmp/homechooser-home-watch.$$}
RT=${HOMECHOOSER_RUNTIME:-$HC_RUNTIME_DIR}
WSH=${HOMECHOOSER_SHELL:-/bin/sh}
APPDIR=${HOMECHOOSER_APPDIR:-/media/developer/apps/usr/palm/applications/org.webosbrew.homechooser}
APPS_DIRS=${HOMECHOOSER_APPS_DIRS:-"/media/developer/apps/usr/palm/applications /usr/palm/applications"}
# Where installed apps' files are, for "still on disk": the appinfo directories and the store's.
INSTALL_DIRS=${HOMECHOOSER_INSTALL_DIRS:-"$APPS_DIRS /media/cryptofs/apps/usr/palm/applications"}
KEYFLAG=${HOMECHOOSER_HOMEKEY_FLAG:-$HC_STATE_DIR/homekey}
INITD=${HOMECHOOSER_INITD:-/var/lib/webosbrew/init.d/homechooser}
BOOT_DIR=${HOMECHOOSER_BOOT_DIR:-/var/lib/webosbrew/homechooser/boot}
RECHECK=${HOMECHOOSER_RECHECK:-300}
TIMER_SLEEP=${HOMECHOOSER_TIMER_SLEEP:-sleep}
CONFIRM_DELAY=${HOMECHOOSER_CONFIRM_DELAY:-15}
TIMEOUT=${HOMECHOOSER_TIMEOUT-timeout}
TMO_FORM=
CHECK_MARK=${HOMECHOOSER_CHECK_MARK:-}
PRELOAD_ON=${HOMECHOOSER_PRELOAD:-1}
PRELOAD_SETTLE=${HOMECHOOSER_PRELOAD_SETTLE:-45}
PRELOAD_SLEEP=${HOMECHOOSER_PRELOAD_SLEEP:-sleep}
PRELOAD_TRIES=${HOMECHOOSER_PRELOAD_TRIES:-12}
PRELOAD_RETRY=${HOMECHOOSER_PRELOAD_RETRY:-10}
NOTIFY_ON=${HOMECHOOSER_NOTIFY:-1}
HC_ID=org.webosbrew.homechooser
STOCK_HOME=$HC_STOCK_HOME
STOCK_FULLHOME=$HC_STOCK_FULLHOME

SETTINGS=luna://com.webos.settingsservice
SAM=luna://com.webos.applicationManager
PROFILE=luna://com.webos.service.systemprofile
PRELOAD=luna://com.webos.service.preloadmanager
NOTIF=luna://com.webos.notification


. "$SCRIPT_DIR/lib/watch-base.sh"
. "$SCRIPT_DIR/lib/watch-record.sh"
. "$SCRIPT_DIR/lib/watch-preload.sh"
. "$SCRIPT_DIR/lib/watch-notify.sh"
. "$SCRIPT_DIR/lib/watch-restore.sh"
. "$SCRIPT_DIR/lib/watch-events.sh"

# --- Start ---------------------------------------------------------------------------------

# Run from the copy in the runtime directory, so that the app being removed or replaced cannot
# pull the script out from under the shell.
SRC=$(cd "$(dirname "$0")" && pwd)
RTDIR=$(cd "$RT" 2>/dev/null && pwd)
if [ "$SRC" != "$RTDIR" ]; then
    if stage_runtime "$SRC"; then
        exec $WSH "$RT/homechooser-home-watch"
    fi
    log "cannot copy the scripts to $RT, running from $SRC"
fi
HOMEKEY=$SRC/homechooser-homekey

trap 'finish "stopped by signal" 0' TERM INT HUP

MAJOR=$(major_version)
if [ "$MAJOR" -ge 6 ] && [ "$MAJOR" -le 9 ] && [ -f "$KEYFLAG" ] &&
   [ -f "${HOMECHOOSER_STALE:-/var/lib/webosbrew/homechooser/hook-stale}" ]; then
    (
        "$SLEEP" "${HOMECHOOSER_PREPARE_DELAY:-45}"
        $WSH "$HOMEKEY" prepare >> "$LOG" 2>&1
    ) </dev/null >/dev/null 2>&1 &
fi
if [ -f "$SRC/homechooser-access" ]; then
    $WSH "$SRC/homechooser-access" apply >> "$LOG" 2>&1 || log "could not apply launcher access"
fi
detect_timeout
LAST_WRITE=0
STREAK=0
LUNA_PID=
NAP_PID=
MISSING=
BAKED=
FEED_PIDS=
CLOSE_PID=
PRELOAD_STATE=
TITLE_ID=
TITLE_VAL=
NOTIFY_OUT=

# A boot entry kept outside the removed package can run this copy even when the old watcher
# had exited without a choice or was stopped. Confirm absence before the no-choice early exit;
# a package update can temporarily remove the app directory too.
if [ ! -d "$APPDIR" ]; then
    check_hc
fi

if ! want=$(read_choice); then
    log "no usable choice file, checking for a leftover home"
    repair_leftover
    want=$(read_choice) || { log "no usable choice file, nothing to watch"; exit 0; }
fi
log "watching, home=$want, webOS $MAJOR"
mkdir -p "$TMP" || exit 1
check_apps start
want=$(read_choice) || finish "choice file is gone, exiting" 0
[ -n "$MISSING" ] || check_override "$want"

mkfifo "$TMP/settings" "$TMP/apps" "$TMP/events" || finish "cannot create the pipes in $TMP" 1
"$LUNA" -a "$HC_LUNA_IDENTITY" -i "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"],"subscribe":true}' > "$TMP/settings" 2>&1 &
LUNA_PID=$!
"$LUNA" -a "$HC_LUNA_IDENTITY" -i "$SAM/listApps" '{"subscribe":true}' > "$TMP/apps" 2>&1 &
LUNA_PID="$LUNA_PID $!"
feed S 0 < "$TMP/settings" > "$TMP/events" &
FEED_PIDS=$!
feed A 1 < "$TMP/apps" > "$TMP/events" &
FEED_PIDS="$FEED_PIDS $!"
ticker > "$TMP/events" &
FEED_PIDS="$FEED_PIDS $!"
exec 3< "$TMP/events"

while IFS= read -r ev <&3; do
    case "$ev" in
        "S "*) handle "${ev#S }" ;;
        A) check_apps apps ;;
        T) check_apps timer ;;
        "E S") finish "subscription ended" 1 ;;
        "E A") log "apps subscription ended, relying on the periodic check" ;;
    esac
done

finish "event stream ended" 1
