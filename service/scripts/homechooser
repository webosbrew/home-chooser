#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# HBC entry: queue the native boot/watcher role once; never wait for readiness.
OSRELEASE=${HOMECHOOSER_OSRELEASE:-/etc/os-release}
SERVICE_SCRIPTS=${HOMECHOOSER_SERVICE_SCRIPTS:-/media/developer/apps/usr/palm/services/org.webosbrew.homechooser.service/scripts}
BOOT_DIR=${HOMECHOOSER_BOOT_DIR:-/var/lib/webosbrew/homechooser/boot}
BINARY=${HOMECHOOSER_BINARY:-$SERVICE_SCRIPTS/../homechooser-daemon}
SYSTEMCTL=${HOMECHOOSER_SYSTEMCTL:-systemctl}
SYSTEMD_RUN=${HOMECHOOSER_SYSTEMD_RUN:-systemd-run}
RUNTIME=${HOMECHOOSER_RUNTIME:-/tmp/homechooser-runtime}
CHOICE=${HOMECHOOSER_CHOICE:-/var/lib/webosbrew/homechooser/home}
major=$(sed -n 's/^VERSION_ID=//p' "$OSRELEASE" 2>/dev/null | sed -n 's/[^0-9]*\([0-9][0-9]*\).*/\1/p' | head -1)

# 5/10+ retain a boot restore copy even if the unit was stopped at uninstall.
# 6-9 reset the volatile hook at reboot and need no persistent executable.
stage_boot() {
    [ "${major:-0}" -lt 6 ] || [ "${major:-0}" -gt 9 ] || return 0
    mkdir -p "$BOOT_DIR/lib" || return 1
    for f in homechooser homechooser-access lib/common.sh; do
        cp "$SERVICE_SCRIPTS/$f" "$BOOT_DIR/$f.new" && chmod 755 "$BOOT_DIR/$f.new" &&
            mv "$BOOT_DIR/$f.new" "$BOOT_DIR/$f" || return 1
    done
    cp "$BINARY" "$BOOT_DIR/homechooser-daemon.new" && chmod 755 "$BOOT_DIR/homechooser-daemon.new" &&
        mv "$BOOT_DIR/homechooser-daemon.new" "$BOOT_DIR/homechooser-daemon"
}
case "$1" in
    stage) stage_boot; exit $? ;;
    unstage) rm -rf "$BOOT_DIR"; exit 0 ;;
    ""|watch) ;;
    *) exit 2 ;;
esac
if [ -x "$BINARY" ]; then
    stage_boot || exit 1
    if [ "${major:-0}" -lt 6 ] || [ "${major:-0}" -gt 9 ]; then
        if [ -z "$1" ]; then
            [ ! -f "$SERVICE_SCRIPTS/homechooser-access" ] || /bin/sh "$SERVICE_SCRIPTS/homechooser-access" apply
            [ -f "$CHOICE" ] || exit 0
        fi
    fi
else
    # A stopped watcher on a legacy release can still recover at the next boot.
    BINARY=$BOOT_DIR/homechooser-daemon
fi
[ -x "$BINARY" ] || [ -x "$RUNTIME/homechooser-daemon" ] || exit 0
"$SYSTEMCTL" is-active --quiet homechooser-home && exit 0
"$SYSTEMCTL" reset-failed homechooser-home 2>/dev/null
exec "$SYSTEMD_RUN" --no-block --unit=homechooser-home --property=Restart=on-failure --property=RestartSec=5 \
    /bin/sh -c '[ -x "$1" ] && exec "$1" --boot; [ -x "$2" ] && exec "$2" --boot; exit 0' \
    homechooser-boot "$BINARY" "$RUNTIME/homechooser-daemon"
