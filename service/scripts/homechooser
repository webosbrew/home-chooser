#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# HBC entry: queue the native boot/watcher role once; never wait for readiness.
RELEASE_FILE=${HOMECHOOSER_RELEASE_FILE:-/etc/starfish-release}
SERVICE_SCRIPTS=${HOMECHOOSER_SERVICE_SCRIPTS:-/media/developer/apps/usr/palm/services/org.webosbrew.homechooser.service/scripts}
BOOT_DIR=${HOMECHOOSER_BOOT_DIR:-/var/lib/webosbrew/homechooser/boot}
BINARY=${HOMECHOOSER_BINARY:-$SERVICE_SCRIPTS/../homechooser-daemon}
SYSTEMCTL=${HOMECHOOSER_SYSTEMCTL:-systemctl}
SYSTEMD_RUN=${HOMECHOOSER_SYSTEMD_RUN:-systemd-run}
RUNTIME=${HOMECHOOSER_RUNTIME:-/tmp/homechooser-runtime}
CHOICE=${HOMECHOOSER_CHOICE:-/var/lib/webosbrew/homechooser/home}
PIDFILE=${HOMECHOOSER_PIDFILE:-$RUNTIME/watcher.pid}
DPIDFILE=${HOMECHOOSER_DAEMON_PIDFILE:-$RUNTIME/watcher-daemon.pid}
PROC=${HOMECHOOSER_PROC:-/proc}
major=$(sed -n 's/.*release \([0-9][0-9]*\)\.[0-9][0-9]*\.[0-9][0-9]*.*/\1/p' "$RELEASE_FILE" 2>/dev/null | head -1)

# 5/10+ retain a boot restore copy even if the unit was stopped at uninstall.
# 6-9 reset the volatile hook at reboot and need no persistent executable.
stage_boot() {
    [ "${major:-0}" -lt 6 ] || [ "${major:-0}" -gt 9 ] || return 0
    mkdir -p "$BOOT_DIR/lib" || return 1
    for f in homechooser homechooser-access lib/common.sh; do
        cp "$SERVICE_SCRIPTS/$f" "$BOOT_DIR/$f.new.$$" && chmod 755 "$BOOT_DIR/$f.new.$$" &&
            mv "$BOOT_DIR/$f.new.$$" "$BOOT_DIR/$f" || return 1
    done
    cp "$BINARY" "$BOOT_DIR/homechooser-daemon.new.$$" && chmod 755 "$BOOT_DIR/homechooser-daemon.new.$$" &&
        mv "$BOOT_DIR/homechooser-daemon.new.$$" "$BOOT_DIR/homechooser-daemon"
}
# webOS 4.0 and 4.5 run upstart, with no systemd: the watcher is then a detached shell loop in its own process
# group (the unit's Restart=on-failure as a loop), found again through a pid file on tmpfs.
have_systemd() { command -v "$SYSTEMD_RUN" > /dev/null 2>&1 && command -v "$SYSTEMCTL" > /dev/null 2>&1; }
# A pid counts only while it is alive and its command line still names homechooser (never signal a recycled pid).
hc_pid() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$1" 2>/dev/null && grep -q homechooser "$PROC/$1/cmdline" 2>/dev/null
}
loop_pid() { pid=$(cat "$PIDFILE" 2>/dev/null) || return 1; hc_pid "$pid"; }
# The daemon moves into its own process group, so a group kill of the loop does not reach it: the loop records its pid.
daemon_pid() { dpid=$(cat "$DPIDFILE" 2>/dev/null) || return 1; hc_pid "$dpid"; }
# Daemons that are no one's child any more, such as one left by 0.2.1 (its loop was stopped without it):
# `homechooser-daemon --boot` owned by this user (root), found by its command line.
orphan_daemons() {
    for d in "$PROC"/[0-9]*; do
        [ -O "$d" ] && [ "${d##*/}" != $$ ] || continue
        case "$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)" in *homechooser-daemon\ --boot\ *) echo "${d##*/}" ;; esac
    done
}
gone() { # gone PID...: wait up to 5 s for all of them to exit
    n=0
    while :; do
        alive=
        for g in "$@"; do kill -0 "$g" 2>/dev/null && alive=1; done
        [ -n "$alive" ] && [ $n -lt 5 ] || return 0
        sleep 1; n=$((n + 1))
    done
}
# Stop the loop first so it cannot restart the daemon, then the daemon(s); wait, KILL what is left, then drop the pid files.
stop_loop() {
    lp=
    if loop_pid; then
        lp=$pid
        kill -s TERM -- "-$lp" 2>/dev/null || kill -s TERM "$lp" 2>/dev/null
        gone "$lp"
        ! kill -0 "$lp" 2>/dev/null || kill -s KILL -- "-$lp" 2>/dev/null || kill -s KILL "$lp" 2>/dev/null
    fi
    dp=
    daemon_pid && dp=$dpid
    dp=$(printf '%s\n' $dp $(orphan_daemons) | sort -u)
    if [ -n "$dp" ]; then
        for g in $dp; do kill -s TERM "$g" 2>/dev/null; done
        gone $dp
        for g in $dp; do ! kill -0 "$g" 2>/dev/null || kill -s KILL "$g" 2>/dev/null; done
        gone $dp
    fi
    rm -f "$PIDFILE" "$DPIDFILE"
}
# Serialise check-and-start and stop on the no-systemd path: an atomic mkdir lock holding the owner's pid. A holder that
# is gone (or whose pid is no homechooser) is stale and is moved aside; waits up to 40 s (a stop takes up to 15 s), then
# goes ahead anyway rather than hang. The lock is dropped when this script exits.
lock_take() {
    LOCK=$RUNTIME/lock
    n=0
    while ! mkdir "$LOCK" 2>/dev/null; do
        holder=$(cat "$LOCK/pid" 2>/dev/null)
        if [ -n "$holder" ] && ! hc_pid "$holder"; then
            mv "$LOCK" "$LOCK.stale.$$" 2>/dev/null && rm -rf "$LOCK.stale.$$"
            continue
        fi
        if [ $n -ge 40 ]; then [ -n "$holder" ] || rm -rf "$LOCK"; return 0; fi
        sleep 1; n=$((n + 1))
    done
    echo $$ > "$LOCK/pid"
    trap 'rm -rf "$LOCK"' EXIT
    trap 'exit 1' HUP INT TERM
}
watcher_active() {
    if have_systemd; then "$SYSTEMCTL" is-active --quiet homechooser-home; else loop_pid || daemon_pid; fi
}
case "$1" in
    stage) stage_boot; exit $? ;;
    unstage) rm -rf "$BOOT_DIR"; exit 0 ;;
    stop)
        if have_systemd; then exec "$SYSTEMCTL" stop homechooser-home; fi
        mkdir -p "$RUNTIME" && lock_take; stop_loop; exit 0 ;;
    active)
        if watcher_active; then echo active; exit 0; fi
        echo inactive; exit 3 ;;
    ""|watch) ;;
    *) exit 2 ;;
esac
if [ -x "$BINARY" ]; then
    stage_boot || exit 1
    if [ "${major:-0}" -lt 6 ] || [ "${major:-0}" -gt 9 ]; then
        if [ -z "$1" ]; then
            [ ! -f "$SERVICE_SCRIPTS/homechooser-access" ] || /bin/sh "$SERVICE_SCRIPTS/homechooser-access" apply
            [ -f "$CHOICE" ] || exit 0
        fi
    fi
else
    # A stopped watcher on a legacy release can still recover at the next boot.
    BINARY=$BOOT_DIR/homechooser-daemon
fi
[ -x "$BINARY" ] || [ -x "$RUNTIME/homechooser-daemon" ] || exit 0
watcher_active && exit 0
if ! have_systemd; then
    mkdir -p "$RUNTIME" || exit 1
    # One starter at a time: a concurrent watch (app open revive and the app's own) waits here, then finds the watcher up.
    lock_take
    ! watcher_active || exit 0
    stop_loop # an orphan daemon left by an older version would otherwise run beside the new one
    setsid /bin/sh -c 'for b in "$1" "$2"; do [ -x "$b" ] && break; b=; done; [ -n "$b" ] || exit 0
        while :; do
            "$b" --boot & p=$!; echo $p > "$3"
            wait $p && { rm -f "$3"; exit 0; }
            rm -f "$3"; sleep 5
        done' homechooser-boot "$BINARY" "$RUNTIME/homechooser-daemon" "$DPIDFILE" \
        < /dev/null > /dev/null 2>&1 &
    echo $! > "$PIDFILE"
    exit 0
fi
"$SYSTEMCTL" reset-failed homechooser-home 2>/dev/null
exec "$SYSTEMD_RUN" --no-block --unit=homechooser-home --property=Restart=on-failure --property=RestartSec=5 \
    /bin/sh -c '[ -x "$1" ] && exec "$1" --boot; [ -x "$2" ] && exec "$2" --boot; exit 0' \
    homechooser-boot "$BINARY" "$RUNTIME/homechooser-daemon"
