#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Maintain the launcher API group in Home Chooser's installer-owned manifest.

set -eu
. "$(dirname "$0")/lib/common.sh"
ROOTS=${HOMECHOOSER_LUNA_ROOTS:-'/var/luna-service2-dev /var/luna-service2'}
CONTROL=${HOMECHOOSER_LS_CONTROL:-ls-control}
PIDOF=${HOMECHOOSER_PIDOF:-pidof}
# Who runs this: Home Chooser's service (the settings app's accessApply) or the boot entry/watcher.
PARENT_EXE=${HOMECHOOSER_PARENT_EXE:-$(readlink "/proc/$PPID/exe" 2>/dev/null || :)}
OSRELEASE=${HOMECHOOSER_OSRELEASE:-/etc/os-release}
changed=0
major=$(major_version)
# The launcher API methods, each with the LG access group that admits apps to it on 11+ (query: the
# reads, launcher: closeApp and uninstallApp): the one list, here. Its names are the spec's
# x-permission.grants plus getInfo (api/launcher-v1.openrpc.json; tests/test-homechooser-access.sh
# checks the two agree). Every grant below is built from it.
LAUNCHER_METHODS='getInfo:query listApps:query listRunning:query getForegroundApp:query getAppInfo:query
getAppIcon:query listLaunchPoints:query listInputs:query getIcons:query closeApp:launcher uninstallApp:launcher'
SERVICE_ID=org.webosbrew.homechooser.service

# The methods (of one LG group, or all) as a JSON array of "<service>/<method>".
method_array() {
    out=
    for entry in $LAUNCHER_METHODS; do
        [ -z "${1:-}" ] || [ "${entry#*:}" = "$1" ] || continue
        out="$out${out:+,}\"$SERVICE_ID/${entry%%:*}\""
    done
    printf '[%s]' "$out"
}

# Strip JSON whitespace outside strings, preserving escaped quotes and spaces in values.
compact() {
    awk 'BEGIN { quoted=0; escaped=0 }
    { for (i=1; i<=length($0); i++) {
        c=substr($0,i,1)
        if (quoted) {
            printf "%s",c
            if (escaped) escaped=0
            else if (c=="\\") escaped=1
            else if (c=="\"") quoted=0
        } else if (c=="\"") { quoted=1; printf "%s",c }
        else if (c !~ /[[:space:]]/) printf "%s",c
    } } END { print "" }' "$1"
}

write_changed() {
    if [ ! -f "$1" ] || [ "$(cat "$1")" != "$2" ]; then
        printf '%s\n' "$2" > "$1.new"
        chmod 644 "$1.new"
        mv "$1.new" "$1"
        changed=1
    fi
}

# The installer manifest uses flat arrays of file names. Remove only our exact entry and drop
# the array if that leaves it empty; add_entry then appends it once. Other entries are preserved.
drop_entry() {
    key=$1 path=$2
    escaped=$(printf '%s' "$path" | sed 's/[.[\*^$\\|]/\\&/g')
    json=$(printf '%s\n' "$json" | sed \
        -e "s|\(\"$key\":\[[^]]*\)\"$escaped\",|\1|g" \
        -e "s|\(\"$key\":\[[^]]*\),\"$escaped\"|\1|g" \
        -e "s|\"$key\":\[\"$escaped\"\]|\"$key\":[]|g" \
        -e "s|\"$key\":\[\],||g" -e "s|,\"$key\":\[\]||g" -e "s|\"$key\":\[\]||g")
}

add_entry() {
    key=$1 path=$2
    drop_entry "$key" "$path"
    if printf '%s\n' "$json" | grep -q "\"$key\":\["; then
        json=$(printf '%s\n' "$json" | sed "s|\"$key\":\[|\"$key\":[\"$path\",|; s|\"$path\",]|\"$path\"]|")
    else
        json=$(printf '%s\n' "$json" | sed "s|^{|{\"$key\":[\"$path\"],|; s|,}|}|")
    fi
}

action=${1:-status}
case "$action" in apply|remove|status) ;; *) echo "usage: $0 apply|remove|status" >&2; exit 2 ;; esac
for root in $ROOTS; do
    manifest=$root/manifests.d/org.webosbrew.homechooser.json
    api=$root/api-permissions.d/org.webosbrew.homechooser.launcher.api.json
    if [ "$action" = status ]; then
        printf '%s manifest=%s api=%s\n' "$root" \
            "$(test -f "$manifest" && echo yes || echo no)" \
            "$(test -f "$api" && echo yes || echo no)"
        continue
    fi
    if [ -f "$manifest" ]; then
        json=$(compact "$manifest")
        case "$json" in \{*\}) ;; *) echo "Invalid manifest: $manifest" >&2; exit 1 ;; esac
        if [ "$action" = apply ]; then
            mkdir -p "$root/api-permissions.d"
            methods=$(method_array)
            permissions="{\"org.webosbrew.homechooser.applications\":$methods"
            # 11+: a developer app holds only the public LG groups (requiredPermissions is ignored), so
            # the methods are also provided under two of them; the service checks the caller itself.
            [ "$major" -lt 11 ] || permissions="$permissions,\"ares.webos.cli\":$methods,\"application.query\":$(method_array query),\"application.launcher\":$(method_array launcher)"
            before=$(cat "$api" 2>/dev/null || :)
            write_changed "$api" "$permissions}"
            # A service registered before the change keeps its old groups: tell the caller to restart it.
            [ "$major" -lt 11 ] || [ "$(cat "$api")" = "$before" ] || restart=1
            add_entry apiPermissionFiles "$api"
        else
            drop_entry apiPermissionFiles "$api"
        fi
        # Compare compact JSON to avoid rewriting an unchanged pretty-printed manifest.
        if [ "$(compact "$manifest")" != "$json" ]; then write_changed "$manifest" "$json"; fi
    fi
    if [ "$action" = remove ] && [ -f "$api" ]; then rm -f "$api"; changed=1; fi
done
if [ "$changed" = 1 ]; then "$CONTROL" scan-services; fi
# 11+: Home Chooser's service takes its access groups when it registers. After a change, a running
# instance must register again. Run by that service (accessApply), tell the settings app, which
# quits it and waits for the new instance; run by the boot entry or the watcher, stop it here (only
# Home Chooser's own service); the hub starts it again on the next call.
if [ "${restart:-0}" = 1 ]; then
    case "$PARENT_EXE" in
        */homechooser-service) echo restart-service ;;
        *) for pid in $("$PIDOF" homechooser-service 2>/dev/null); do kill "$pid" 2>/dev/null || :; done ;;
    esac
fi
