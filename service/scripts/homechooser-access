#!/bin/sh
# Maintain the launcher API group in installer-owned manifests.

set -eu
. "$(dirname "$0")/lib/common.sh"
ROOTS=${HOMECHOOSER_LUNA_ROOTS:-'/var/luna-service2-dev /var/luna-service2'}
CONTROL=${HOMECHOOSER_LS_CONTROL:-ls-control}
OSRELEASE=${HOMECHOOSER_OSRELEASE:-/etc/os-release}
changed=0
major=$(major_version)

# Strip JSON whitespace outside strings, preserving escaped quotes and spaces in values.
compact() {
    awk 'BEGIN { quoted=0; escaped=0 }
    { for (i=1; i<=length($0); i++) {
        c=substr($0,i,1)
        if (quoted) {
            printf "%s",c
            if (escaped) escaped=0
            else if (c=="\\") escaped=1
            else if (c=="\"") quoted=0
        } else if (c=="\"") { quoted=1; printf "%s",c }
        else if (c !~ /[[:space:]]/) printf "%s",c
    } } END { print "" }' "$1"
}

write_changed() {
    if [ ! -f "$1" ] || [ "$(cat "$1")" != "$2" ]; then
        printf '%s\n' "$2" > "$1.new"
        chmod 644 "$1.new"
        mv "$1.new" "$1"
        changed=1
    fi
}

# The installer manifest uses flat arrays of file names. Remove only our exact entry and drop
# the array if that leaves it empty; add_entry then appends it once. Other entries are preserved.
drop_entry() {
    key=$1 path=$2
    escaped=$(printf '%s' "$path" | sed 's/[.[\*^$\\|]/\\&/g')
    json=$(printf '%s\n' "$json" | sed \
        -e "s|\(\"$key\":\[[^]]*\)\"$escaped\",|\1|g" \
        -e "s|\(\"$key\":\[[^]]*\),\"$escaped\"|\1|g" \
        -e "s|\"$key\":\[\"$escaped\"\]|\"$key\":[]|g" \
        -e "s|\"$key\":\[\],||g" -e "s|,\"$key\":\[\]||g" -e "s|\"$key\":\[\]||g")
}

add_entry() {
    key=$1 path=$2
    drop_entry "$key" "$path"
    if printf '%s\n' "$json" | grep -q "\"$key\":\["; then
        json=$(printf '%s\n' "$json" | sed "s|\"$key\":\[|\"$key\":[\"$path\",|; s|\"$path\",]|\"$path\"]|")
    else
        json=$(printf '%s\n' "$json" | sed "s|^{|{\"$key\":[\"$path\"],|; s|,}|}|")
    fi
}

action=${1:-status}
case "$action" in apply|remove|status) ;; *) echo "usage: $0 apply|remove|status" >&2; exit 2 ;; esac
for root in $ROOTS; do
    manifest=$root/manifests.d/org.webosbrew.homechooser.json
    api=$root/api-permissions.d/org.webosbrew.homechooser.launcher.api.json
    legacy_group=$root/groups.d/homechooser.groups.json
    if [ "$action" = status ]; then
        printf '%s manifest=%s api=%s legacy-group=%s\n' "$root" \
            "$(test -f "$manifest" && echo yes || echo no)" \
            "$(test -f "$api" && echo yes || echo no)" \
            "$(test -f "$legacy_group" && echo yes || echo no)"
        continue
    fi
    if [ -f "$manifest" ]; then
        json=$(compact "$manifest")
        case "$json" in \{*\}) ;; *) echo "Invalid manifest: $manifest" >&2; exit 1 ;; esac
        drop_entry groupsFiles "$legacy_group"
        if [ "$action" = apply ]; then
            mkdir -p "$root/api-permissions.d"
            methods='["org.webosbrew.homechooser.service/listApps","org.webosbrew.homechooser.service/listRunning","org.webosbrew.homechooser.service/closeApp","org.webosbrew.homechooser.service/uninstallApp","org.webosbrew.homechooser.service/getInfo"]'
            permissions="{\"org.webosbrew.homechooser.applications\":$methods"
            [ "$major" -lt 11 ] || permissions="$permissions,\"ares.webos.cli\":$methods"
            write_changed "$api" "$permissions}"
            add_entry apiPermissionFiles "$api"
        else
            drop_entry apiPermissionFiles "$api"
        fi
        # Compare compact JSON to avoid rewriting an unchanged pretty-printed manifest.
        if [ "$(compact "$manifest")" != "$json" ]; then write_changed "$manifest" "$json"; fi
    fi
    # Legacy group file: nothing loads it once the manifest entry is gone.
    if [ -f "$legacy_group" ]; then rm -f "$legacy_group"; changed=1; fi
    if [ "$action" = remove ] && [ -f "$api" ]; then rm -f "$api"; changed=1; fi
done
if [ "$changed" = 1 ]; then "$CONTROL" scan-services; fi
