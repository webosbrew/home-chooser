{
	"name": "org.webosbrew.openhouse",
	"version": "0.1.0",
	"description": "Choose which app the Home button opens on a rooted LG webOS TV.",
	"main": "src/index.js",
	"scripts": {
		"pack": "enact pack",
		"pack-p": "enact pack -p",
		"clean": "enact clean",
		"lint": "enact lint src",
		"test": "enact test --watchAll=false",
		"check-ilib": "node scripts/check-ilib.js dist",
		"package": "npm run pack-p && node scripts/prune-ilib.js dist && node scripts/check-ilib.js dist && node scripts/copy-backport.js dist && ares-package dist --outdir ../build/ipk"
	},
	"license": "Apache-2.0",
	"private": true,
	"enact": {
		"theme": "moonstone"
	},
	"browserslist": [
		"chrome 68"
	],
	"eslintConfig": {
		"extends": "enact-proxy"
	},
	"eslintIgnore": [
		"node_modules/*",
		"build/*",
		"dist/*"
	],
	"dependencies": {
		"@enact/core": "4.8.0",
		"@enact/i18n": "4.8.0",
		"@enact/moonstone": "4.5.6",
		"@enact/spotlight": "4.8.0",
		"@enact/ui": "4.8.0",
		"ilib": "^14.21.2",
		"prop-types": "^15.8.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@enact/cli": "6.1.4",
		"eslint-config-enact-proxy": "^1.0.9"
	}
}
