// Home Chooser E2E fixture launcher (QML), run by /usr/bin/qml-runner (appinfo "type": "qml").
// build.sh fills the @MARKER@ placeholders. The root is a WebOSWindow, as in LG's own type:"qml" apps
// (com.webos.exampleapp.nav): its appId (must equal the appinfo id) and windowType are what LSM and SAM key on.
import QtQuick 2.0
import Eos.Window 0.1

WebOSWindow {
    width: 1920
    height: 1080
    visible: true
    color: "@BGCOLOR@"
    appId: "@APPID@"
    title: "@TITLE@"
@WINDOWTYPE@
@BODY@
}
