#!/bin/sh
# Home Chooser key filter backport, webOS 6.6.0 to 9.2.1.
#
# Installed in /var/lib/webosbrew/init.d/ and run as root by Homebrew Channel at boot.
#
# The boot hook runs after the compositor has started (systemd starts surface-manager-daemon long
# before devmode's startup.sh, and /var is not even mounted then), so `apply` is the boot path: it
# mounts and restarts the compositor in the firmware's order. The Home Chooser app no longer calls
# apply or stop; it writes a flag and asks the user to reboot. apply, stop and `refresh restart`
# are kept for manual and debug use (docs/key-filter-backport.md, "Restarting the compositor").
#
#   homechooser-keyfilter          apply: find the diff set whose stock hashes match the live
#                                files, patch copies of them in /tmp, bind-mount the copies
#                                over the originals and restart the compositor (boot path, debug)
#   homechooser-keyfilter stop     unmount what apply mounted and restart the compositor (debug)
#   homechooser-keyfilter refresh [stock] [restart]
#                                if mounted, write the stored choice into the mounted copy of
#                                Settings.qml again; with `stock`, write an empty id whatever is
#                                stored (the watcher does that while the chosen app is not
#                                installed). It never restarts the compositor unless `restart` is
#                                given (debug): the loaded QML keeps its old value, but
#                                getHomeAppId reads the settings record first, so the baked id is
#                                only the fallback for the next start. `norestart` is accepted and
#                                does nothing.
#   homechooser-keyfilter apply samfirst   restart sam first, then as apply
#   homechooser-keyfilter status   print mounted=yes|no and release=<set> or match=<set>|none,
#                                and reboot=needed|no: needed when the flag file exists and
#                                nothing is mounted though a reviewed set matches (or the generated
#                                patch is possible and opted in), or when the flag file is absent
#                                and something is still mounted
#
# The data directory holds one directory per release with a manifest.json and the diffs. A set
# is applied all or nothing. Nothing on the rootfs is modified.
#
# The patched Settings.qml carries a `configuredHomeAppId: "@HOMECHOOSER_HOME@"` line. After patch
# the script replaces the placeholder with the id stored in /var/lib/webosbrew/homechooser/home
# (trimmed, and only if it is letters, digits, '.', '-' and '_'; otherwise an empty string), so
# the key filter has a home id when the settings record has none. The id is baked in only if
# `applicationManager/getAppInfo` says the app is installed; an uninstalled app, or a sam that
# does not answer within HOMECHOOSER_SAM_WAIT seconds (20), bakes the empty id, which the key filter
# reads as the stock home. The watcher (homechooser-home-watch) refreshes it later. Called from the
# init.d entry `homechooser`, which decides whether the backport is enabled.
#
# Overrides, for tests: HOMECHOOSER_LUNA_SEND, HOMECHOOSER_SAM_WAIT, HOMECHOOSER_SLEEP, HOMECHOOSER_TIMEOUT, HOMECHOOSER_CHOICE, HOMECHOOSER_DATA, HOMECHOOSER_ROOT (prefix of the target paths),
# HOMECHOOSER_WORK, HOMECHOOSER_LOG, HOMECHOOSER_KEYFILTER_FLAG (the enable flag, default
# /var/lib/webosbrew/homechooser/keyfilter), HOMECHOOSER_GENERATED_FLAG, HOMECHOOSER_MOUNTS, HOMECHOOSER_MOUNT, HOMECHOOSER_UMOUNT,
# HOMECHOOSER_SYSTEMCTL, HOMECHOOSER_PATCH, HOMECHOOSER_SHA256, HOMECHOOSER_UNIT,
# HOMECHOOSER_DEPENDANTS (the units stopped before and started after the compositor restart,
# instead of the list read from lsm-ready.service; empty means none).
#
# "Restart the compositor" is: stop those of webapp-mgr, booster and maliit-server (the clients
# the firmware's lsm-ready.service restarts) that are running, restart surface-manager-daemon,
# start them again. Stopping WebAppMgr closes every web app, Home Chooser's own UI included.
# Only apply (the boot path), stop and `refresh restart` do this.

DATA=${HOMECHOOSER_DATA:-/media/developer/apps/usr/palm/applications/org.webosbrew.homechooser/backport}
ROOT=${HOMECHOOSER_ROOT:-}
WORK=${HOMECHOOSER_WORK:-/tmp/homechooser-backport}
LOG=${HOMECHOOSER_LOG:-/tmp/homechooser-backport.log}
MOUNTS=${HOMECHOOSER_MOUNTS:-/proc/mounts}
MOUNT=${HOMECHOOSER_MOUNT:-mount}
UMOUNT=${HOMECHOOSER_UMOUNT:-umount}
SYSTEMCTL=${HOMECHOOSER_SYSTEMCTL:-systemctl}
PATCH=${HOMECHOOSER_PATCH:-patch}
SHA256=${HOMECHOOSER_SHA256:-sha256sum}
UNIT=${HOMECHOOSER_UNIT:-surface-manager-daemon.service}
DEPENDANTS_DEFAULT="webapp-mgr.service booster.service maliit-server.service"
CHOICE=${HOMECHOOSER_CHOICE:-/var/lib/webosbrew/homechooser/home}
LUNA=${HOMECHOOSER_LUNA_SEND:-luna-send}
HC_LUNA_IDENTITY=com.webos.applicationManager    # privileged luna calls run with this identity (docs/service.md)
SAM_WAIT=${HOMECHOOSER_SAM_WAIT:-20}
SLEEP=${HOMECHOOSER_SLEEP:-sleep}
TIMEOUT=${HOMECHOOSER_TIMEOUT-timeout}
KEYFILTER_FLAG=${HOMECHOOSER_KEYFILTER_FLAG:-/var/lib/webosbrew/homechooser/keyfilter}
GENERATED_FLAG=${HOMECHOOSER_GENERATED_FLAG:-/var/lib/webosbrew/homechooser/keyfilter-generated}
NO_SETS_FLAG=${HOMECHOOSER_NO_SETS_FLAG:-/var/lib/webosbrew/homechooser/debug-no-sets}
NODE=${HOMECHOOSER_NODE:-node}
command -v "$NODE" >/dev/null 2>&1 || NODE=/usr/bin/node
GEN=${HOMECHOOSER_GEN:-$(dirname "$0")/homechooser-keyfilter-gen.js}
TMO_FORM=

log() {
    msg="$(date '+%Y-%m-%d %H:%M:%S') $*"
    echo "$msg"
    echo "$msg" >> "$LOG" 2>/dev/null
}

# entries <manifest>: print path, sha256 and diff name of every file, one per line, in order.
# The manifest is JSON; the three keys are picked line by line, so the layout does not matter.
entries() {
    tr '{},' '\n\n\n' < "$1" |
        sed -En 's/^[[:space:]]*"(path|sha256|diff)"[[:space:]]*:[[:space:]]*"([^"]*)".*$/\2/p'
}

# configured_id: print the stored home id, trimmed; nothing if absent, empty or invalid.
configured_id() {
    [ -f "$CHOICE" ] || return 0
    id=$(tr -d '\r' < "$CHOICE" | tr '\n\t' '  ' | sed -e 's/^ *//' -e 's/ *$//')
    [ -n "$id" ] || return 0
    if printf '%s' "$id" | grep -q '[^A-Za-z0-9._-]'; then
        log "ignoring invalid app id in $CHOICE: '$id'" >&2
        return 0
    fi
    printf '%s' "$id"
}

# detect_timeout: once, find how `timeout` is called: `timeout SECS CMD` (BusyBox 1.30 and later,
# GNU) or `timeout -t SECS CMD` (BusyBox before 1.30, e.g. 1.29.2 on webOS 5). Sets TMO_FORM to
# new, old or none.
detect_timeout() {
    [ -n "$TMO_FORM" ] && return 0
    TMO_FORM=none
    [ -n "$TIMEOUT" ] && command -v "$TIMEOUT" > /dev/null 2>&1 || return 0
    if "$TIMEOUT" 1 true > /dev/null 2>&1; then
        TMO_FORM=new
    elif "$TIMEOUT" -t 1 true > /dev/null 2>&1; then
        TMO_FORM=old
    fi
}

# app_state <id>: print yes (installed), no (sam answers returnValue false) or unknown (no
# answer). getAppInfo of an uninstalled id answers returnValue:false.
app_state() {
    detect_timeout
    case "$TMO_FORM" in
        new) set -- "$TIMEOUT" 10 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.applicationManager/getAppInfo "{\"id\":\"$1\"}" ;;
        old) set -- "$TIMEOUT" -t 10 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.applicationManager/getAppInfo "{\"id\":\"$1\"}" ;;
        *) set -- "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.applicationManager/getAppInfo "{\"id\":\"$1\"}" ;;
    esac
    out=$("$@" 2>&1 | tr '\n' ' ')
    if printf '%s' "$out" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*true'; then
        echo yes
    elif printf '%s' "$out" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*false'; then
        echo no
    else
        echo unknown
    fi
}

# baked_id: the id to put into the patched Settings.qml: the stored choice if that app is
# installed, else nothing (the stock home). Waits up to SAM_WAIT seconds for sam to answer.
baked_id() {
    bid=$(configured_id)
    [ -n "$bid" ] || return 0
    waited=0
    while :; do
        st=$(app_state "$bid")
        case "$st" in
            yes) printf '%s' "$bid"; return 0 ;;
            no) log "$bid is not installed, using the stock home" >&2; return 0 ;;
        esac
        if [ "$waited" -ge "$SAM_WAIT" ]; then
            log "sam did not answer for $bid in $SAM_WAIT s, using the stock home until the watcher refreshes it" >&2
            return 0
        fi
        "$SLEEP" 2
        waited=$((waited + 2))
    done
}

# set_configured <file> <id>: put <id> into the configuredHomeAppId line, in place (same inode,
# so a bind mount of the file sees it).
set_configured() {
    sed "s|configuredHomeAppId: \"[^\"]*\"|configuredHomeAppId: \"$2\"|" "$1" > "$1.new" &&
        cat "$1.new" > "$1"
    r=$?
    rm -f "$1.new"
    return $r
}

has_configured() {
    grep -q 'configuredHomeAppId: "' "$1" 2>/dev/null
}

is_mounted() {
    grep -qF " $1 " "$MOUNTS" 2>/dev/null
}

sha_of() {
    "$SHA256" "$1" 2>/dev/null | cut -d' ' -f1
}

mkdir -p "$WORK" 2>/dev/null

# Temp files are named per invocation: status runs from the app, the watcher and the service can
# overlap, and a shared name let one run delete or truncate the list another was reading.
# ETMP is the read-only scratch list (any_mounted, find_set, status, refresh, stop); AENT is the
# apply list. Both are removed on every way out.
ETMP="$WORK/entries.$$.tmp"
AENT="$WORK/entries.$$"
LOCKDIR="$WORK/lock.d"
LOCK_WAIT=${HOMECHOOSER_LOCK_WAIT:-120}
HAVE_LOCK=0

cleanup() {
    rm -f "$ETMP" "$AENT"
    [ "$HAVE_LOCK" = 1 ] && rm -rf "$LOCKDIR"
    HAVE_LOCK=0
}
trap cleanup EXIT
trap 'exit 143' HUP INT TERM

# take_lock: apply, stop and refresh change mounts and the staged copies, so only one runs at a
# time. status takes no lock; it only reads, and reads a consistent answer at every step (the
# stock files match until the first bind mount, and a mount is only reported once it exists).
# A lock whose owner is gone is taken over; after LOCK_WAIT seconds the run gives up.
take_lock() {
    waited=0
    while ! mkdir "$LOCKDIR" 2>/dev/null; do
        owner=$(cat "$LOCKDIR/pid" 2>/dev/null)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            rm -rf "$LOCKDIR"
            continue
        fi
        if [ "$waited" -ge "$LOCK_WAIT" ]; then
            log "ERROR: another keyfilter run holds $LOCKDIR (pid ${owner:-unknown}), giving up"
            exit 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
    HAVE_LOCK=1
    echo $$ > "$LOCKDIR/pid"
}

# any_mounted: succeed when a target of any set in the data directory is a mount point.
any_mounted() {
    for m in "$DATA"/*/manifest.json "$WORK/generated/manifest.json"; do
        [ -f "$m" ] || continue
        entries "$m" > "$ETMP"
        while read -r p && read -r h && read -r d; do
            if is_mounted "$ROOT$p"; then
                rm -f "$ETMP"
                return 0
            fi
        done < "$ETMP"
    done
    rm -f "$ETMP"
    return 1
}

# find_set: print the release whose files all match their stock hash, if any.
find_set() {
    [ "${HOMECHOOSER_NO_SETS:-0}" = 1 ] && return 1
    [ -f "$NO_SETS_FLAG" ] && return 1
    for m in "$DATA"/*/manifest.json; do
        [ -f "$m" ] || continue
        rel=$(basename "$(dirname "$m")")
        entries "$m" > "$ETMP"
        match=1
        count=0
        while read -r p && read -r h && read -r d; do
            count=$((count + 1))
            cur=
            [ -f "$ROOT$p" ] && cur=$(sha_of "$ROOT$p")
            [ "$cur" = "$h" ] || match=0
        done < "$ETMP"
        rm -f "$ETMP"
        if [ "$match" = 1 ] && [ "$count" -gt 0 ]; then
            echo "$rel"
            return 0
        fi
    done
    return 1
}

# Cache checks by content, including discovery/guard inputs and the rules themselves.
# Hash all QML/JS in these trees, so a new target or stray stock id invalidates the cache too.
generated_key() {
    {
        printf '%s\n' "$NODE"
        "$SHA256" "$GEN" "$ROOT/etc/os-release" 2>/dev/null
        find "$ROOT/usr/lib/qml/WebOSCompositor" "$ROOT/usr/lib/qml/KeyFilters" \
             "$ROOT/usr/lib/qml/WebOSCompositorBase" -type f \
             \( -name '*.qml' -o -name '*.js' \) -exec "$SHA256" {} + 2>/dev/null | LC_ALL=C sort
    } | "$SHA256" | cut -d' ' -f1
}

generated_status() {
    key=$(generated_key)
    cache="$WORK/check-$key"
    if [ ! -f "$cache" ]; then
        if "$NODE" "$GEN" check --root "${ROOT:-/}" > "$WORK/check.$$.out" 2>&1; then
            echo generated=possible > "$WORK/check.$$.result"
        else
            {
                echo generated=refused
                printf 'reason='
                tr '\n\r' '  ' < "$WORK/check.$$.out"
                printf '\n'
            } > "$WORK/check.$$.result"
        fi
        mv "$WORK/check.$$.result" "$cache"
        rm -f "$WORK/check.$$.out"
    fi
    cat "$cache"
    if [ -f "$GENERATED_FLAG" ]; then echo optin=yes; else echo optin=no; fi
}

active_manifest() {
    rel=$(cat "$WORK/release" 2>/dev/null)
    if [ "$rel" = generated ]; then
        echo "$WORK/generated/manifest.json"
    else
        echo "$DATA/$rel/manifest.json"
    fi
}

# compositor_dependants: the compositor's clients that the firmware restarts once the compositor is
# ready, in its order: the `systemctl start <unit>` lines of lsm-ready.service (/etc before /lib,
# as systemd reads them). All releases 6.5.2 to 9.2.4 list webapp-mgr, booster and maliit-server,
# which is also the fallback when the unit is not found (docs/key-filter-backport.md, "Restarting
# the compositor").
compositor_dependants() {
    if [ -n "${HOMECHOOSER_DEPENDANTS+set}" ]; then
        echo "$HOMECHOOSER_DEPENDANTS"
        return 0
    fi
    for f in "$ROOT/etc/systemd/system/lsm-ready.service" "$ROOT/lib/systemd/system/lsm-ready.service"; do
        [ -f "$f" ] || continue
        list=$(sed -n 's|^ExecStart=[^ ]*systemctl start \([A-Za-z0-9@._-]*\.service\)[[:space:]]*$|\1|p' "$f" | tr '\n' ' ')
        if [ -n "$list" ]; then
            echo $list
            return 0
        fi
    done
    echo "$DEPENDANTS_DEFAULT"
}

# unit_running <unit>: active, or on its way there (the same set systemd try-restarts).
unit_running() {
    case "$("$SYSTEMCTL" is-active "$1" 2>/dev/null)" in
        active|activating|reloading) return 0 ;;
    esac
    return 1
}

# restart_sequence <dependants...>: stop the dependants that are running, restart the compositor,
# start them again. The daemon is Type=notify and its READY=1 is sent by the initctl shim when the
# compositor emits lsm-ready, so `restart` returns once the compositor is ready, and the clients
# connect to a compositor that has announced its outputs, as at boot. A client left running while
# the compositor goes away exits on a broken pipe, is respawned by Restart=on-failure while the new
# compositor is still starting, and WebAppMgr can crash there (9.2.1, scratch/wam-crash/notes.md).
restart_sequence() {
    was=
    for u in "$@"; do
        unit_running "$u" && was="$was $u"
    done
    for u in $was; do
        log "stopping $u"
        "$SYSTEMCTL" stop "$u" || log "ERROR: could not stop $u"
    done
    r=0
    log "restarting $UNIT"
    if "$SYSTEMCTL" restart "$UNIT"; then
        log "$UNIT restarted"
    else
        log "ERROR: could not restart $UNIT"
        r=1
    fi
    # Started even if the restart failed: a TV without WebAppMgr has no web apps at all.
    for u in $was; do
        log "starting $u"
        "$SYSTEMCTL" start "$u" || { log "ERROR: could not start $u"; r=1; }
    done
    return $r
}

# restart_compositor: restart_sequence in a child of its own, waited for. The child does not hold
# the caller's stdout or stderr (Home Chooser's service reads them through pipes and SIGKILLs this
# worker at its timeout), so the stop and the start cannot be separated by the death of this
# process or of the web app that asked for the run, which the stop of webapp-mgr closes. Its
# output is copied to ours afterwards.
restart_compositor() {
    deps=$(compositor_dependants)
    out="$WORK/restart.$$.out"
    (
        trap '' HUP INT PIPE
        restart_sequence $deps
    ) < /dev/null > "$out" 2>&1 &
    wait $!
    r=$?
    cat "$out" 2>/dev/null
    rm -f "$out"
    return $r
}

undo_mounts() {
    [ -f "$WORK/mounted" ] || return 0
    while read -r t; do
        "$UMOUNT" "$t" 2>/dev/null || "$UMOUNT" -l "$t" 2>/dev/null
    done < "$WORK/mounted"
    rm -f "$WORK/mounted"
}

do_apply() {
    detect_timeout
    # `apply samfirst`: restart sam before anything else. The settings app asks for this when its
    # first write created general/defaultApps (webOS 6 to 8: sam misses that write until it
    # restarts). Restarting sam brings the stock home forward and closes the settings panel, so
    # the restart has to be part of this one root-side run: a panel that is gone cannot make the
    # next call. Whatever happens below, the restart has been done.
    if [ "$1" = samfirst ]; then
        log "restarting sam"
        "$SYSTEMCTL" restart sam || log "ERROR: could not restart sam"
    fi
    if any_mounted; then
        log "key filter backport already mounted, nothing to do"
        return 0
    fi
    rel=$(find_set)
    rm -rf "$WORK/stage" "$WORK/generated"
    if [ -z "$rel" ]; then
        log "no diff set matches the stock files"
        [ -f "$GENERATED_FLAG" ] || { log "generated patch not opted in, leaving stock"; return 0; }
        mkdir -p "$WORK/generated"
        "$NODE" "$GEN" generate --root "${ROOT:-/}" --out "$WORK/stage" \
            --manifest "$WORK/generated/manifest.json" >> "$LOG" 2>&1
        r=$?
        if [ "$r" != 0 ]; then
            log "generator failed ($r), leaving stock; see $LOG"
            rm -rf "$WORK/stage" "$WORK/generated"
            [ "$r" = 2 ] && return 0
            return 1
        fi
        rel=generated
        entries "$WORK/generated/manifest.json" > "$AENT"
    else
        log "diff set $rel matches the stock files"
        set_dir="$DATA/$rel"
        mkdir -p "$WORK/stage"
        entries "$set_dir/manifest.json" > "$AENT"

        # Copy every target, then patch every copy; any failure drops the whole set.
        while read -r p && read -r h && read -r d; do
            mkdir -p "$WORK/stage$(dirname "$p")" && cp -p "$ROOT$p" "$WORK/stage$p" || {
                log "ERROR: cannot copy $p, set $rel not applied"
                rm -rf "$WORK/stage" "$AENT"
                return 1
            }
        done < "$AENT"
        while read -r p && read -r h && read -r d; do
            if ! (cd "$WORK/stage" && "$PATCH" -p0 < "$set_dir/$d") >> "$LOG" 2>&1; then
                log "ERROR: $d does not apply to $p, set $rel not applied"
                rm -rf "$WORK/stage" "$AENT"
                return 1
            fi
            log "patched $p with $d"
        done < "$AENT"
    fi

    # Put the stored choice into the copies that carry the placeholder.
    cid=$(baked_id)
    while read -r p && read -r h && read -r d; do
        if has_configured "$WORK/stage$p"; then
            set_configured "$WORK/stage$p" "$cid" || {
                log "ERROR: cannot set the configured home in $p, set $rel not applied"
                rm -rf "$WORK/stage" "$AENT"
                return 1
            }
            log "configured home in $p: '${cid:-none}'"
        fi
    done < "$AENT"

    # Bind-mount the copies; if one fails, undo the ones already mounted.
    : > "$WORK/mounted"
    while read -r p && read -r h && read -r d; do
        if "$MOUNT" --bind "$WORK/stage$p" "$ROOT$p"; then
            echo "$ROOT$p" >> "$WORK/mounted"
            log "mounted $p"
        else
            log "ERROR: cannot mount over $p, set $rel not applied"
            undo_mounts
            rm -rf "$WORK/stage" "$AENT"
            return 1
        fi
    done < "$AENT"
    rm -f "$AENT"
    echo "$rel" > "$WORK/release"

    restart_compositor
}

do_stop() {
    unmounted=0
    for m in "$DATA"/*/manifest.json "$WORK/generated/manifest.json"; do
        [ -f "$m" ] || continue
        entries "$m" > "$ETMP"
        while read -r p && read -r h && read -r d; do
            tries=0
            while is_mounted "$ROOT$p" && [ "$tries" -lt 3 ]; do
                tries=$((tries + 1))
                if "$UMOUNT" "$ROOT$p" 2>/dev/null || "$UMOUNT" -l "$ROOT$p" 2>/dev/null; then
                    log "unmounted $p"
                    unmounted=1
                else
                    log "ERROR: cannot unmount $p"
                    break
                fi
            done
        done < "$ETMP"
    done
    # Keep the generated target list and mounted sources if an unmount failed, so status and a
    # later stop can still find them even when no reviewed set names these files.
    if any_mounted; then
        log "ERROR: targets remain mounted; keeping stage and manifest for a later stop"
        return 1
    fi
    rm -rf "$WORK/stage" "$WORK/mounted" "$WORK/release" "$AENT" "$ETMP" "$WORK/generated"
    if [ "$unmounted" = 1 ]; then
        restart_compositor
    else
        log "nothing mounted, nothing to do"
    fi
}

do_refresh() {
    detect_timeout
    any_mounted || { log "nothing mounted, nothing to refresh"; return 0; }
    cid=; stock=0; restart=0
    for a in "$@"; do
        case "$a" in
            stock) stock=1 ;;
            restart) restart=1 ;;
            norestart) ;;
        esac
    done
    [ "$stock" = 1 ] || cid=$(baked_id)
    changed=0
    entries "$(active_manifest)" > "$ETMP" 2>/dev/null
    while read -r p && read -r h && read -r d; do
        f="$WORK/stage$p"
        has_configured "$f" || continue
        grep -qF "configuredHomeAppId: \"$cid\"" "$f" && continue
        set_configured "$f" "$cid" && { log "configured home in $p: '${cid:-none}'"; changed=1; }
    done < "$ETMP"
    rm -f "$ETMP"
    if [ "$changed" != 1 ]; then
        log "configured home unchanged"
    elif [ "$restart" = 1 ]; then
        restart_compositor
    else
        log "configured home updated; the running compositor keeps its loaded id until the next start (the settings record is read first)"
    fi
}

do_status() {
    if [ ! -d "$DATA" ]; then
        echo "data=missing"
    fi
    reboot=no
    if any_mounted; then
        echo "mounted=yes"
        echo "release=$(cat "$WORK/release" 2>/dev/null || echo unknown)"
        if [ "$(cat "$WORK/release" 2>/dev/null)" = generated ]; then
            echo match=generated
            entries "$WORK/generated/manifest.json" > "$ETMP"
            while read -r p && read -r h && read -r d; do
                echo "hash=$(sha_of "$WORK/stage$p") $p"
            done < "$ETMP"
            rm -f "$ETMP"
        fi
        [ -f "$KEYFILTER_FLAG" ] || reboot=needed
    else
        echo "mounted=no"
        rel=$(find_set)
        echo "match=${rel:-none}"
        if [ -n "$rel" ]; then
            [ -f "$KEYFILTER_FLAG" ] && reboot=needed
        else
            gen=$(generated_status)
            printf '%s\n' "$gen"
            if [ -f "$KEYFILTER_FLAG" ] && printf '%s\n' "$gen" | grep -q '^generated=possible$' &&
                [ -f "$GENERATED_FLAG" ]; then
                reboot=needed
            fi
        fi
    fi
    echo "reboot=$reboot"
}

case "$1" in
    ""|apply) [ $# -gt 0 ] && shift; take_lock; do_apply "$@" ;;
    stop)     take_lock; do_stop ;;
    refresh)  shift; take_lock; do_refresh "$@" ;;
    status)   do_status ;;
    *)        echo "usage: $0 [apply [samfirst]|stop|refresh [stock] [restart]|status]" >&2; exit 2 ;;
esac
