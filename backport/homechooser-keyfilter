#!/bin/sh
# Minimal Home-key hook for webOS 6-9. Called by homechooser at boot only.
# Rewrites copies under /tmp, bind-mounts them, then restarts the compositor in firmware order.
# On restart or functional QML readiness failure, removes the mounts and tries one stock restart. No runtime restarts.
# refresh [stock] rewrites the stored-id fallback in the staged Settings.qml in place.
# stop and refresh restart retain explicit manual/debug restart support.
# status reports patch=possible|refused, unpatched-sites=N, skipped=reason and file=/path.
# Overrides: HOMECHOOSER_{ROOT,WORK,LOG,MOUNTS,MOUNT,UMOUNT,SYSTEMCTL,UNIT,
# CHOICE,LUNA_SEND,SAM_WAIT,SLEEP,TIMEOUT,KEYFILTER_FLAG,NODE,GEN,DEPENDANTS,LOCK_WAIT,READY_WAIT,DEBUG_BREAK_SETTINGS}.

ROOT=${HOMECHOOSER_ROOT:-}
WORK=${HOMECHOOSER_WORK:-/tmp/homechooser-backport}
LOG=${HOMECHOOSER_LOG:-/tmp/homechooser-backport.log}
MOUNTS=${HOMECHOOSER_MOUNTS:-/proc/mounts}
MOUNT=${HOMECHOOSER_MOUNT:-mount}
UMOUNT=${HOMECHOOSER_UMOUNT:-umount}
SYSTEMCTL=${HOMECHOOSER_SYSTEMCTL:-systemctl}
UNIT=${HOMECHOOSER_UNIT:-surface-manager-daemon.service}
DEPENDANTS_DEFAULT="webapp-mgr.service booster.service maliit-server.service"
CHOICE=${HOMECHOOSER_CHOICE:-/var/lib/webosbrew/homechooser/home}
LUNA=${HOMECHOOSER_LUNA_SEND:-luna-send}
HC_LUNA_IDENTITY=com.webos.applicationManager    # privileged luna calls run with this identity (docs/service.md)
SAM_WAIT=${HOMECHOOSER_SAM_WAIT:-20}
READY_WAIT=${HOMECHOOSER_READY_WAIT:-24}
VERIFY_QML=0
SLEEP=${HOMECHOOSER_SLEEP:-sleep}
TIMEOUT=${HOMECHOOSER_TIMEOUT-timeout}
KEYFILTER_FLAG=${HOMECHOOSER_KEYFILTER_FLAG:-/var/lib/webosbrew/homechooser/keyfilter}
NODE=${HOMECHOOSER_NODE:-node}
command -v "$NODE" >/dev/null 2>&1 || NODE=/usr/bin/node
GEN=${HOMECHOOSER_GEN:-$(dirname "$0")/homechooser-keyfilter-gen.js}
TMO_FORM=

log() {
    msg="$(date '+%Y-%m-%d %H:%M:%S') $*"
    echo "$msg"
    echo "$msg" >> "$LOG" 2>/dev/null
}

# entries <manifest>: print staged target paths, one per line, in order.
entries() {
    tr '{},' '\n\n\n' < "$1" |
        sed -En 's/^[[:space:]]*"(path)"[[:space:]]*:[[:space:]]*"([^"]*)".*$/\2/p'
}

# configured_id: print the stored home id, trimmed; nothing if absent, empty or invalid.
configured_id() {
    [ -f "$CHOICE" ] || return 0
    id=$(tr -d '\r' < "$CHOICE" | tr '\n\t' '  ' | sed -e 's/^ *//' -e 's/ *$//')
    [ -n "$id" ] || return 0
    if printf '%s' "$id" | grep -q '[^A-Za-z0-9._-]'; then
        log "ignoring invalid app id in $CHOICE: '$id'" >&2
        return 0
    fi
    printf '%s' "$id"
}

# detect_timeout: once, find how `timeout` is called: `timeout SECS CMD` (BusyBox 1.30 and later,
# GNU) or `timeout -t SECS CMD` (BusyBox before 1.30, e.g. 1.29.2 on webOS 5). Sets TMO_FORM to
# new, old or none.
detect_timeout() {
    [ -n "$TMO_FORM" ] && return 0
    TMO_FORM=none
    [ -n "$TIMEOUT" ] && command -v "$TIMEOUT" > /dev/null 2>&1 || return 0
    if "$TIMEOUT" 1 true > /dev/null 2>&1; then
        TMO_FORM=new
    elif "$TIMEOUT" -t 1 true > /dev/null 2>&1; then
        TMO_FORM=old
    fi
}

# A C++ compositor can report READY=1 even when main.qml failed. getCurrentState is
# registered by the stock StarfishBaseLunaServiceAPI QML object, independently of tier 2.
# Require both success and its string-valued currentState, not merely a live Luna service.
# Each request is bounded to two seconds; the entire polling window is READY_WAIT (24s).
qml_ready() {
    detect_timeout
    deadline=$(($(cut -d. -f1 /proc/uptime) + READY_WAIT))
    ready_attempt=0
    reply="$WORK/ready.$$.out"
    while :; do
        ready_attempt=$((ready_attempt + 1))
        case "$TMO_FORM" in
            new) "$TIMEOUT" 2 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.surfacemanager/getCurrentState '{}' > "$reply" 2>&1 ;;
            old) "$TIMEOUT" -t 2 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.surfacemanager/getCurrentState '{}' > "$reply" 2>&1 ;;
            *)
                # No timeout applet: bound the native luna-send child ourselves and reap it.
                "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.surfacemanager/getCurrentState '{}' > "$reply" 2>&1 &
                ready_pid=$!
                for ready_tick in 1 2; do
                    kill -0 "$ready_pid" 2>/dev/null || break
                    sleep 1
                done
                kill "$ready_pid" 2>/dev/null
                wait "$ready_pid" 2>/dev/null
                ;;
        esac
        if grep -q '"returnValue"[[:space:]]*:[[:space:]]*true' "$reply" &&
           grep -q '"currentState"[[:space:]]*:[[:space:]]*"[^"]*"' "$reply"; then
            log "QML ready via getCurrentState (attempt $ready_attempt)"
            rm -f "$reply"
            return 0
        fi
        if [ "$(cut -d. -f1 /proc/uptime)" -ge "$deadline" ]; then
            reason="QML getCurrentState unavailable after $READY_WAIT s: $(tr '\n\r' '  ' < "$reply" | cut -c1-240)"
            printf '%s\n' "$reason" > "$WORK/restart-reason"
            log "ERROR: $reason"
            rm -f "$reply"
            return 1
        fi
        "$SLEEP" 1
    done
}

# app_state <id>: print yes (installed), no (sam answers returnValue false) or unknown (no
# answer). getAppInfo of an uninstalled id answers returnValue:false.
app_state() {
    detect_timeout
    case "$TMO_FORM" in
        new) set -- "$TIMEOUT" 10 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.applicationManager/getAppInfo "{\"id\":\"$1\"}" ;;
        old) set -- "$TIMEOUT" -t 10 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.applicationManager/getAppInfo "{\"id\":\"$1\"}" ;;
        *) set -- "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 luna://com.webos.applicationManager/getAppInfo "{\"id\":\"$1\"}" ;;
    esac
    out=$("$@" 2>&1 | tr '\n' ' ')
    if printf '%s' "$out" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*true'; then
        echo yes
    elif printf '%s' "$out" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*false'; then
        echo no
    else
        echo unknown
    fi
}

# baked_id: the id to put into the patched Settings.qml: the stored choice if that app is
# installed, else nothing (the stock home). Waits up to SAM_WAIT seconds for sam to answer.
baked_id() {
    bid=$(configured_id)
    [ -n "$bid" ] || return 0
    waited=0
    while :; do
        st=$(app_state "$bid")
        case "$st" in
            yes) printf '%s' "$bid"; return 0 ;;
            no) log "$bid is not installed, using the stock home" >&2; return 0 ;;
        esac
        if [ "$waited" -ge "$SAM_WAIT" ]; then
            log "sam did not answer for $bid in $SAM_WAIT s, using the stock home until the watcher refreshes it" >&2
            return 0
        fi
        "$SLEEP" 2
        waited=$((waited + 2))
    done
}

# set_configured <file> <id>: put <id> into the configuredHomeAppId line, in place (same inode,
# so a bind mount of the file sees it).
set_configured() {
    sed "s|configuredHomeAppId: \"[^\"]*\"|configuredHomeAppId: \"$2\"|" "$1" > "$1.new" &&
        cat "$1.new" > "$1"
    r=$?
    rm -f "$1.new"
    return $r
}

has_configured() {
    grep -q 'configuredHomeAppId: "' "$1" 2>/dev/null
}

is_mounted() {
    grep -qF " $1 " "$MOUNTS" 2>/dev/null
}

mkdir -p "$WORK" 2>/dev/null

# Temp files are named per invocation: status runs from the app, the watcher and the service can
# overlap, and a shared name let one run delete or truncate the list another was reading.
# ETMP is the read-only scratch list (any_mounted, status, refresh, stop); AENT is the
# apply list. Both are removed on every way out.
ETMP="$WORK/entries.$$.tmp"
AENT="$WORK/entries.$$"
LOCKDIR="$WORK/lock.d"
LOCK_WAIT=${HOMECHOOSER_LOCK_WAIT:-120}
HAVE_LOCK=0

cleanup() {
    rm -f "$ETMP" "$AENT"
    [ "$HAVE_LOCK" = 1 ] && rm -rf "$LOCKDIR"
    HAVE_LOCK=0
}
trap cleanup EXIT
trap 'exit 143' HUP INT TERM

# take_lock: apply, stop and refresh change mounts and the staged copies, so only one runs at a
# time. status takes no lock; it only reads, and reads a consistent answer at every step (the
# stock files match until the first bind mount, and a mount is only reported once it exists).
# A lock whose owner is gone is taken over; after LOCK_WAIT seconds the run gives up.
take_lock() {
    waited=0
    while ! mkdir "$LOCKDIR" 2>/dev/null; do
        owner=$(cat "$LOCKDIR/pid" 2>/dev/null)
        if [ -n "$owner" ] && ! kill -0 "$owner" 2>/dev/null; then
            rm -rf "$LOCKDIR"
            continue
        fi
        if [ "$waited" -ge "$LOCK_WAIT" ]; then
            log "ERROR: another keyfilter run holds $LOCKDIR (pid ${owner:-unknown}), giving up"
            exit 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
    HAVE_LOCK=1
    echo $$ > "$LOCKDIR/pid"
}

# Our staged target list owns the mounts.
any_mounted() {
    [ -f "$WORK/manifest.json" ] || return 1
    entries "$WORK/manifest.json" > "$ETMP"
    while read -r p; do
        if is_mounted "$ROOT$p"; then rm -f "$ETMP"; return 0; fi
    done < "$ETMP"
    rm -f "$ETMP"
    return 1
}

# Check the current files directly; there is no firmware lookup or content-key cache.
patch_status() {
    result="$WORK/check.$$.out"
    if "$NODE" "$GEN" check --root "${ROOT:-/}" > "$result" 2>&1; then
        cat "$result"
    else
        echo patch=refused
        printf 'reason='
        tr '\n\r' '  ' < "$result"
        printf '\n'
    fi
    rm -f "$result"
}

# compositor_dependants: the compositor's clients that the firmware restarts once the compositor is
# ready, in its order: the `systemctl start <unit>` lines of lsm-ready.service (/etc before /lib,
# as systemd reads them). All releases 6.5.2 to 9.2.4 list webapp-mgr, booster and maliit-server,
# which is also the fallback when the unit is not found (docs/key-filter-backport.md, "Restarting
# the compositor").
compositor_dependants() {
    if [ -n "${HOMECHOOSER_DEPENDANTS+set}" ]; then
        echo "$HOMECHOOSER_DEPENDANTS"
        return 0
    fi
    for f in "$ROOT/etc/systemd/system/lsm-ready.service" "$ROOT/lib/systemd/system/lsm-ready.service"; do
        [ -f "$f" ] || continue
        list=$(sed -n 's|^ExecStart=[^ ]*systemctl start \([A-Za-z0-9@._-]*\.service\)[[:space:]]*$|\1|p' "$f" | tr '\n' ' ')
        if [ -n "$list" ]; then
            echo $list
            return 0
        fi
    done
    echo "$DEPENDANTS_DEFAULT"
}

# unit_running <unit>: active, or on its way there (the same set systemd try-restarts).
unit_running() {
    case "$("$SYSTEMCTL" is-active "$1" 2>/dev/null)" in
        active|activating|reloading) return 0 ;;
    esac
    return 1
}

# restart_sequence <dependants...>: stop the dependants that are running, restart the compositor,
# start them again. The daemon is Type=notify and its READY=1 is sent by the initctl shim when the
# compositor emits lsm-ready. This proves process readiness; the boot path also requires the
# QML-served method before clients connect. A client left running while
# the compositor goes away exits on a broken pipe, is respawned by Restart=on-failure while the new
# compositor is still starting, and WebAppMgr can crash there (9.2.1, scratch/wam-crash/notes.md).
restart_sequence() {
    was=$(cat "$WORK/restart-clients" 2>/dev/null)
    for u in "$@"; do
        case " $was " in *" $u "*) continue ;; esac
        unit_running "$u" && was="$was $u"
    done
    printf '%s\n' "$was" > "$WORK/restart-clients"
    for u in $was; do
        log "stopping $u"
        "$SYSTEMCTL" stop "$u" || log "ERROR: could not stop $u"
    done
    r=0
    log "restarting $UNIT"
    if "$SYSTEMCTL" restart "$UNIT"; then
        log "$UNIT restarted"
    else
        log "ERROR: could not restart $UNIT"
        echo "systemctl restart $UNIT failed" > "$WORK/restart-reason"
        # Keep clients stopped until a ready compositor exists; boot recovery retries stock.
        return 1
    fi
    if [ "$VERIFY_QML" = 1 ]; then
        qml_ready || return 1
    fi
    for u in $was; do
        log "starting $u"
        "$SYSTEMCTL" start "$u" || { log "ERROR: could not start $u"; r=1; }
    done
    rm -f "$WORK/restart-clients"
    return $r
}

# restart_compositor: restart_sequence in a child of its own, waited for. The child does not hold
# the caller's stdout or stderr (Home Chooser's service reads them through pipes and SIGKILLs this
# worker at its timeout), so the stop and the start cannot be separated by the death of this
# process or of the web app that asked for the run, which the stop of webapp-mgr closes. Its
# output is copied to ours afterwards.
restart_compositor() {
    deps=$(compositor_dependants)
    out="$WORK/restart.$$.out"
    (
        trap '' HUP INT PIPE
        restart_sequence $deps
    ) < /dev/null > "$out" 2>&1 &
    wait $!
    r=$?
    cat "$out" 2>/dev/null
    rm -f "$out"
    return $r
}

undo_mounts() {
    [ -f "$WORK/mounted" ] || return 0
    failed=0
    while read -r t; do
        if is_mounted "$t"; then
            "$UMOUNT" "$t" 2>/dev/null || "$UMOUNT" -l "$t" 2>/dev/null || failed=1
        fi
    done < "$WORK/mounted"
    [ "$failed" = 0 ] || return 1
    rm -f "$WORK/mounted"
}

do_apply() {
    detect_timeout
    # `apply samfirst`: restart sam before anything else. The settings app asks for this when its
    # first write created general/defaultApps (webOS 6 to 8: sam misses that write until it
    # restarts). Restarting sam brings the stock home forward and closes the settings panel, so
    # the restart has to be part of this one root-side run: a panel that is gone cannot make the
    # next call. Whatever happens below, the restart has been done.
    if [ "$1" = samfirst ]; then
        log "restarting sam"
        "$SYSTEMCTL" restart sam || log "ERROR: could not restart sam"
    fi
    if any_mounted; then
        log "key filter backport already mounted, nothing to do"
        return 0
    fi
    rm -rf "$WORK/stage"
    rm -f "$WORK/manifest.json" "$WORK/applied-status" "$WORK/recovered" "$WORK/restart-reason"
    "$NODE" "$GEN" generate --root "${ROOT:-/}" --out "$WORK/stage" \
        --manifest "$WORK/manifest.json" > "$WORK/plan.$$" 2>&1
    r=$?
    cat "$WORK/plan.$$" >> "$LOG"
    if [ "$r" != 0 ]; then
        log "rewriter failed ($r): $(cat "$WORK/plan.$$"); leaving stock"
        rm -rf "$WORK/stage"
        rm -f "$WORK/manifest.json" "$WORK/plan.$$"
        [ "$r" = 2 ] && return 0
        return 1
    fi
    mv "$WORK/plan.$$" "$WORK/applied-status"
    entries "$WORK/manifest.json" > "$AENT"
    # Put the stored choice into the copies that carry the placeholder.
    cid=$(baked_id)
    while read -r p; do
        if has_configured "$WORK/stage$p"; then
            set_configured "$WORK/stage$p" "$cid" || {
                log "ERROR: cannot set the configured home in $p, hook not applied"
                rm -rf "$WORK/stage" "$AENT"
                return 1
            }
            log "configured home in $p: '${cid:-none}'"
        fi
    done < "$AENT"

    # Test-only fault injection, after the real rewrite, before any mount. Never enabled by the app.
    if [ "${HOMECHOOSER_DEBUG_BREAK_SETTINGS:-0}" = 1 ]; then
        broken="$WORK/stage/usr/lib/qml/WebOSCompositorBase/global/Settings.qml"
        [ -f "$broken" ] || { log "ERROR: debug Settings.qml target missing"; return 1; }
        log "DEBUG: injecting a Settings.qml syntax error into the staged copy"
        printf '\nHOMECHOOSER DEBUG BROKEN QML !!!\n' >> "$broken" || return 1
    fi

    # Bind-mount the copies; if one fails, undo the ones already mounted.
    : > "$WORK/mounted"
    while read -r p; do
        if "$MOUNT" --bind "$WORK/stage$p" "$ROOT$p"; then
            echo "$ROOT$p" >> "$WORK/mounted"
            log "mounted $p"
        else
            log "ERROR: cannot mount over $p, hook not applied"
            undo_mounts || { log "ERROR: partial mounts remain; keeping stage and manifest"; return 1; }
            rm -rf "$WORK/stage" "$AENT"
            return 1
        fi
    done < "$AENT"
    rm -f "$AENT"
    VERIFY_QML=1
    if restart_compositor; then return 0; fi
    failure=$(cat "$WORK/restart-reason" 2>/dev/null)
    [ -n "$failure" ] || failure="compositor restart sequence failed"
    log "ERROR: boot compositor restart failed: $failure; unmounting the hook and restarting once to stock"
    undo_mounts || { log "ERROR: recovery could not unmount all targets; keeping stage"; return 1; }
    if restart_compositor; then
        log "stock compositor recovery succeeded"
        printf 'recovered=stock\nreason=%s\n' "$failure" > "$WORK/recovered"
    else
        log "ERROR: stock compositor recovery failed: $(cat "$WORK/restart-reason" 2>/dev/null)"
        printf 'recovered=failed\nreason=%s; stock recovery: %s\n' "$failure" "$(cat "$WORK/restart-reason" 2>/dev/null)" > "$WORK/recovered"
    fi
    rm -rf "$WORK/stage"
    rm -f "$WORK/manifest.json" "$WORK/applied-status"
    return 1
}

do_stop() {
    unmounted=0
    for m in "$WORK/manifest.json"; do
        [ -f "$m" ] || continue
        entries "$m" > "$ETMP"
        while read -r p; do
            tries=0
            while is_mounted "$ROOT$p" && [ "$tries" -lt 3 ]; do
                tries=$((tries + 1))
                if "$UMOUNT" "$ROOT$p" 2>/dev/null || "$UMOUNT" -l "$ROOT$p" 2>/dev/null; then
                    log "unmounted $p"
                    unmounted=1
                else
                    log "ERROR: cannot unmount $p"
                    break
                fi
            done
        done < "$ETMP"
    done
    # Keep the target list and mounted sources if an unmount failed, so status and a
    # later stop can still find them.
    if any_mounted; then
        log "ERROR: targets remain mounted; keeping stage and manifest for a later stop"
        return 1
    fi
    rm -rf "$WORK/stage" "$WORK/mounted" "$WORK/applied-status" "$AENT" "$ETMP" "$WORK/manifest.json"
    if [ "$unmounted" = 1 ]; then
        restart_compositor
    else
        log "nothing mounted, nothing to do"
    fi
}

do_refresh() {
    detect_timeout
    any_mounted || { log "nothing mounted, nothing to refresh"; return 0; }
    cid=; stock=0; restart=0
    for a in "$@"; do
        case "$a" in
            stock) stock=1 ;;
            restart) restart=1 ;;
            norestart) ;;
        esac
    done
    [ "$stock" = 1 ] || cid=$(baked_id)
    changed=0
    entries "$WORK/manifest.json" > "$ETMP" 2>/dev/null
    while read -r p; do
        f="$WORK/stage$p"
        has_configured "$f" || continue
        grep -qF "configuredHomeAppId: \"$cid\"" "$f" && continue
        set_configured "$f" "$cid" && { log "configured home in $p: '${cid:-none}'"; changed=1; }
    done < "$ETMP"
    rm -f "$ETMP"
    if [ "$changed" != 1 ]; then
        log "configured home unchanged"
    elif [ "$restart" = 1 ]; then
        restart_compositor
    else
        log "configured home updated; the running compositor keeps its loaded id until the next start (the settings record is read first)"
    fi
}

do_status() {
    [ -f "$GEN" ] || echo data=missing
    reboot=no
    if any_mounted; then
        echo mounted=yes
        cat "$WORK/applied-status" 2>/dev/null
        [ -f "$KEYFILTER_FLAG" ] || reboot=needed
    else
        echo mounted=no
        state=$(patch_status)
        printf '%s\n' "$state"
        if [ -f "$KEYFILTER_FLAG" ] && printf '%s\n' "$state" | grep -q '^patch=possible$'; then
            reboot=needed
        fi
    fi
    [ ! -f "$WORK/recovered" ] || cat "$WORK/recovered"
    echo "reboot=$reboot"
}

case "$1" in
    ""|apply) [ $# -gt 0 ] && shift; take_lock; do_apply "$@" ;;
    stop)     take_lock; do_stop ;;
    refresh)  shift; take_lock; do_refresh "$@" ;;
    status)   do_status ;;
    *)        echo "usage: $0 [apply [samfirst]|stop|refresh [stock] [restart]|status]" >&2; exit 2 ;;
esac
