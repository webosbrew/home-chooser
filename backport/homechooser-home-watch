#!/bin/sh
# Home Chooser home watcher. Runs as root under the transient unit homechooser-home, started by
# the init.d entry `homechooser` (or by the app). See docs/settings-app.md, "Persistence" and
# "When apps are removed".
#
# It keeps the stored choice (/var/lib/webosbrew/homechooser/home, the app id alone)
# in the general/defaultApps record. It subscribes to the record and, whenever its `home` is
# missing or differs from the choice, writes the choice again:
#   webOS 9 and later  applicationManager/setDefaultApp (setSystemSettings if the method is unknown)
#   webOS 5 to 8       setSystemSettings with the existing entries and home
# On webOS 10 and later it also keeps the system profile override file naming the choice.
#
# It also watches the two apps it depends on. It subscribes to applicationManager/listApps, which
# is only a trigger (the format of the change messages is not relied on), and on every message,
# and every HOMECHOOSER_RECHECK seconds (300) as a fallback, asks getAppInfo about the chosen app and
# about org.webosbrew.homechooser:
#   chosen app gone: the platform is put back to stock (webOS 5 to 9: home = the stock launcher,
#     com.webos.app.fullhome if installed, else com.webos.app.home, so on 6 to 9 the running
#     compositor opens LG Home at once; on 6 to 9 the backport's baked id is also emptied; 10 and later:
#     override file removed, rescan, `home` written as null), the choice file is kept, and nothing is
#     written while the app is missing. When it is installed again the choice is applied again.
#   Home Chooser gone: the same revert, then the choice file, the backport flag and the init.d link
#     are removed and the watcher exits 0. The backport's bind mounts (webOS 6 to 9) stay until the
#     next reboot: their sources are under /tmp/homechooser-backport, not in the app directory, and
#     nothing re-applies them at boot once the init.d link and the flag are gone.
# An app is taken as gone only if it is still gone HOMECHOOSER_CONFIRM_DELAY seconds (15) later,
# because an update installs by removing first. At a watcher start (a boot, where sam may not have
# loaded every app yet) an app whose appinfo.json is still on disk is not taken as gone either.
#
# Without a usable stored choice it does one check and exits 0 (docs/settings-app.md, "A leftover
# Home"): if the record's home, or on webOS 10 and later the override file's, names an app that is
# not installed (getAppInfo says so twice, the delay apart, and its files are gone), that is what an
# earlier Home Chooser left when it could not restore, and the same revert is made. A getAppInfo
# that does not answer, an installed app, or a stock id leaves it. A choice stored meanwhile turns
# the run into the ordinary watcher.
#
# While a third-party home is chosen (webOS 6 and later) it also keeps LG's stock home,
# com.webos.app.home, from being preloaded: preloadmanager/setPreloadPolicy with isEnabled false,
# without "permanent", so nothing is persisted and a reboot starts stock again; then a forced
# closeByAppId of the stock home, which frees its memory (not on webOS 6 to 10, whatever the
# launcher: sam relaunches the stock home at once as the last-input app, so the close frees nothing;
# it stays resident until the next reboot, after which the policy keeps it closed). Once per boot and once per transition
# (choice becomes a third-party home, becomes stock, the chosen app goes missing or returns; at
# exit 0, i.e. restore to stock or Home Chooser uninstalled, the policy is set back to enabled).
# Best effort: a short timeout, the reply is logged, a failure is never retried and never blocks
# anything else. At start the close waits HOMECHOOSER_PRELOAD_SETTLE seconds (45) in the
# background, because on 5.x to 9.x snapshot-boot-components launches the stock home at boot,
# outside the preload manager. webOS 5 is left alone (docs/settings-app.md).
#
# The user is told once about each removal that puts the stock home back (best effort, see
# docs/settings-app.md, "When apps are removed"): a chosen app removed gets an alert with an OK button
# (luna://com.webos.notification/createAlert; a refused alert is shown as a toast), Home Chooser
# removed gets a toast (createToast). Both use the fixed HC_LUNA_IDENTITY with `-a`, sent after
# the revert, under a short timeout; the reply is logged
# and a failure never blocks the restore. Not sent at a watcher start (a boot with the app still
# missing is not a new removal) and not for the temporary absence of an update.
#
# The watcher never restarts the compositor: it calls the worker as `refresh` or `refresh stock`,
# which only rewrite the baked id in the mounted copy (docs/key-filter-backport.md).
#
# The app's files are deleted with the app, so at start the watcher copies itself, the key filter
# worker into /tmp/homechooser-runtime/ and runs from there.
#
# Storms: at most one write per interval (10 s); each write that follows the last one closely
# doubles the interval, up to 5 min. Every action is logged to /tmp/homechooser-home.log.
# It exits 0 when the choice file is gone or unusable or after the Home Chooser restore, and 1
# when the settings subscription ends (the unit restarts it on failure).
#
# Overrides, for tests: HOMECHOOSER_CHOICE, HOMECHOOSER_LUNA_SEND, HOMECHOOSER_WATCH_LOG,
# HOMECHOOSER_OSRELEASE, HOMECHOOSER_OVERRIDE, HOMECHOOSER_MIN_INTERVAL, HOMECHOOSER_BACKOFF_CAP,
# HOMECHOOSER_LOG_MAX, HOMECHOOSER_CLOCK (command printing epoch seconds), HOMECHOOSER_SLEEP,
# HOMECHOOSER_TMP, HOMECHOOSER_RUNTIME, HOMECHOOSER_SHELL, HOMECHOOSER_APPDIR, HOMECHOOSER_KEYFILTER_FLAG,
# HOMECHOOSER_INITD, HOMECHOOSER_RECHECK, HOMECHOOSER_TIMER_SLEEP, HOMECHOOSER_CONFIRM_DELAY,
# HOMECHOOSER_TIMEOUT, HOMECHOOSER_CHECK_MARK (file that gets a line after each app check),
# HOMECHOOSER_APPS_DIRS, HOMECHOOSER_INSTALL_DIRS (directories of installed apps),
# HOMECHOOSER_PRELOAD_SETTLE, HOMECHOOSER_PRELOAD_SLEEP, HOMECHOOSER_PRELOAD (0 turns the preload
# policy off), HOMECHOOSER_NOTIFY (0 turns the removal notifications off).

CHOICE=${HOMECHOOSER_CHOICE:-/var/lib/webosbrew/homechooser/home}
LUNA=${HOMECHOOSER_LUNA_SEND:-luna-send}
HC_LUNA_IDENTITY=com.webos.applicationManager
LOG=${HOMECHOOSER_WATCH_LOG:-/tmp/homechooser-home.log}
OSRELEASE=${HOMECHOOSER_OSRELEASE:-/etc/os-release}
OVERRIDE=${HOMECHOOSER_OVERRIDE:-/var/webos-profile/override/org.webosbrew.homechooser.json}
MIN_INTERVAL=${HOMECHOOSER_MIN_INTERVAL:-10}
BACKOFF_CAP=${HOMECHOOSER_BACKOFF_CAP:-300}
LOG_MAX=${HOMECHOOSER_LOG_MAX:-65536}
CLOCK=${HOMECHOOSER_CLOCK:-}
SLEEP=${HOMECHOOSER_SLEEP:-sleep}
TMP=${HOMECHOOSER_TMP:-/tmp/homechooser-home-watch.$$}
RT=${HOMECHOOSER_RUNTIME:-/tmp/homechooser-runtime}
WSH=${HOMECHOOSER_SHELL:-/bin/sh}
APPDIR=${HOMECHOOSER_APPDIR:-/media/developer/apps/usr/palm/applications/org.webosbrew.homechooser}
APPS_DIRS=${HOMECHOOSER_APPS_DIRS:-"/media/developer/apps/usr/palm/applications /usr/palm/applications"}
# Where installed apps' files are, for "still on disk": the appinfo directories and the store's.
INSTALL_DIRS=${HOMECHOOSER_INSTALL_DIRS:-"$APPS_DIRS /media/cryptofs/apps/usr/palm/applications"}
KEYFLAG=${HOMECHOOSER_KEYFILTER_FLAG:-/var/lib/webosbrew/homechooser/keyfilter}
INITD=${HOMECHOOSER_INITD:-/var/lib/webosbrew/init.d/homechooser}
OLD_INITD=$(dirname "$INITD")/homechooser-keyfilter
RECHECK=${HOMECHOOSER_RECHECK:-300}
TIMER_SLEEP=${HOMECHOOSER_TIMER_SLEEP:-sleep}
CONFIRM_DELAY=${HOMECHOOSER_CONFIRM_DELAY:-15}
TIMEOUT=${HOMECHOOSER_TIMEOUT-timeout}
TMO_FORM=
CHECK_MARK=${HOMECHOOSER_CHECK_MARK:-}
PRELOAD_ON=${HOMECHOOSER_PRELOAD:-1}
PRELOAD_SETTLE=${HOMECHOOSER_PRELOAD_SETTLE:-45}
PRELOAD_SLEEP=${HOMECHOOSER_PRELOAD_SLEEP:-sleep}
PRELOAD_TRIES=${HOMECHOOSER_PRELOAD_TRIES:-12}
PRELOAD_RETRY=${HOMECHOOSER_PRELOAD_RETRY:-10}
NOTIFY_ON=${HOMECHOOSER_NOTIFY:-1}
HC_ID=org.webosbrew.homechooser
STOCK_HOME=com.webos.app.home
STOCK_FULLHOME=com.webos.app.fullhome

SETTINGS=luna://com.webos.settingsservice
SAM=luna://com.webos.applicationManager
PROFILE=luna://com.webos.service.systemprofile
PRELOAD=luna://com.webos.service.preloadmanager
NOTIF=luna://com.webos.notification

now() {
    if [ -n "$CLOCK" ]; then $CLOCK; else date +%s; fi
}

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null
    size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    if [ "$((size + 0))" -gt "$LOG_MAX" ]; then
        tail -n 200 "$LOG" > "$LOG.$$.tmp" 2>/dev/null && mv "$LOG.$$.tmp" "$LOG"
    fi
}

# The major release, from os-release the way the app reads it.
major_version() {
    for key in VERSION_ID VERSION PRETTY_NAME; do
        v=$(sed -n "s/^$key=//p" "$OSRELEASE" 2>/dev/null | sed -n 's/[^0-9]*\([0-9][0-9]*\).*/\1/p' | head -n 1)
        if [ -n "$v" ]; then echo "$v"; return 0; fi
    done
    echo 0
}

# Copy what the removal path needs out of the app directory: this script, the key filter worker
# and the access helper. Each file is
# replaced by rename, so a copy that is running is never rewritten in place.
stage_runtime() {
    mkdir -p "$RT" || return 1
    for f in homechooser-home-watch homechooser-keyfilter homechooser-access; do
        if [ ! -f "$1/$f" ]; then
            [ "$f" != homechooser-home-watch ] && continue
            return 1
        fi
        cp "$1/$f" "$RT/$f.new" && chmod 755 "$RT/$f.new" && mv "$RT/$f.new" "$RT/$f" || return 1
    done

}

# read_choice: print the stored home id. The file holds the id alone; surrounding spaces, tabs,
# CR and LF are trimmed. Fails when the file is absent, empty, or holds anything but letters,
# digits, '.', '-' and '_' (the invalid case is logged).
read_choice() {
    [ -f "$CHOICE" ] || return 1
    id=$(tr -d '\r' < "$CHOICE" | tr '\n\t' '  ' | sed -e 's/^ *//' -e 's/ *$//')
    [ -n "$id" ] || return 1
    if printf '%s' "$id" | grep -q '[^A-Za-z0-9._-]'; then
        log "ignoring invalid app id in $CHOICE: '$id'"
        return 1
    fi
    printf '%s' "$id"
}

# call <uri> <payload>: print luna-send's output.
call() {
    "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 "$1" "$2" 2>&1
}

flatten() {
    tr '\n' ' '
}

# home_of <flat reply>: the record's home, or nothing. The record may come as an object or as
# a JSON string (then its quotes are escaped).
home_of() {
    printf '%s' "$1" |
        sed -n 's/.*\\\{0,1\}"home\\\{0,1\}"[[:space:]]*:[[:space:]]*\\\{0,1\}"\([^"\\]*\)\\\{0,1\}".*/\1/p'
}

# record_body <flat reply>: the members of the defaultApps object, without braces. Prints
# nothing and fails when the record is there but not a flat object of members.
record_body() {
    case "$1" in
        *'"defaultApps"'*) ;;
        *) return 0 ;;
    esac
    body=$(printf '%s' "$1" |
        sed -n 's/.*"defaultApps"[[:space:]]*:[[:space:]]*{\([^{}]*\)}.*/\1/p')
    if [ -z "$body" ]; then
        body=$(printf '%s' "$1" |
            sed -n 's/.*"defaultApps"[[:space:]]*:[[:space:]]*"{\([^{}]*\)}".*/\1/p' | sed 's/\\"/"/g')
    fi
    if [ -z "$body" ]; then
        # An empty object is fine; anything else is not understood.
        printf '%s' "$1" | grep -q '"defaultApps"[[:space:]]*:[[:space:]]*"\{0,1\}{[[:space:]]*}' && return 0
        return 1
    fi
    printf '%s' "$body"
}

ok_reply() {
    printf '%s' "$1" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*true'
}

# Pause without blocking signals.
nap() {
    $SLEEP "$1" &
    NAP_PID=$!
    wait "$NAP_PID" 2>/dev/null
    NAP_PID=
}

cleanup() {
    [ -n "$LUNA_PID" ] && kill $LUNA_PID 2>/dev/null
    [ -n "$FEED_PIDS" ] && kill $FEED_PIDS 2>/dev/null
    [ -n "$NAP_PID" ] && kill "$NAP_PID" 2>/dev/null
    [ -n "$CLOSE_PID" ] && kill "$CLOSE_PID" 2>/dev/null
    rm -rf "$TMP"
}

finish() {
    log "$1"
    [ "${2:-0}" -eq 0 ] && preload_sync on exit
    cleanup
    exit "${2:-0}"
}

# The merged setSystemSettings write: the existing entries are read back and kept. With an empty
# id `home` is written as null: sub-keys of the record can never be removed (a write without
# `home` only looks like a replace until the settings service restarts), and null reads as unset
# (docs/research/home-key-and-home-app.md, the 11.2.0 / 10.3.1 results).
merged_write() {
    reply=$(call "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"]}' | flatten)
    if ! rest=$(record_body "$reply"); then
        log "cannot read the defaultApps record, not writing: $reply"
        return 1
    fi
    rest=$(printf '%s' "$rest" |
        sed -e 's/"home"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,//' \
            -e 's/,[[:space:]]*"home"[[:space:]]*:[[:space:]]*"[^"]*"//' \
            -e 's/^[[:space:]]*"home"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*$//' \
            -e 's/"home"[[:space:]]*:[[:space:]]*null[[:space:]]*,//' \
            -e 's/,[[:space:]]*"home"[[:space:]]*:[[:space:]]*null//' \
            -e 's/^[[:space:]]*"home"[[:space:]]*:[[:space:]]*null[[:space:]]*$//')
    rest=$(printf '%s' "$rest" | sed -e 's/^[[:space:]]*,//' -e 's/,[[:space:]]*$//')
    if [ -z "$(printf '%s' "$rest" | tr -d '[:space:]')" ]; then
        if [ -n "$1" ]; then record="{\"home\":\"$1\"}"; else record="{\"home\":null}"; fi
    elif [ -n "$1" ]; then
        record="{\"home\":\"$1\",$rest}"
    else
        record="{\"home\":null,$rest}"
    fi
    out=$(call "$SETTINGS/setSystemSettings" "{\"category\":\"general\",\"settings\":{\"defaultApps\":$record}}" | flatten)
    if ok_reply "$out"; then
        log "setSystemSettings wrote $record"
        return 0
    fi
    log "setSystemSettings failed: $out"
    return 1
}

apply_record() {
    if [ "$MAJOR" -ge 9 ]; then
        out=$(call "$SAM/setDefaultApp" "{\"category\":\"home\",\"appId\":\"$1\"}" | flatten)
        if ok_reply "$out"; then
            log "setDefaultApp home=$1 ok"
            return 0
        fi
        if printf '%s' "$out" | grep -qi 'unknown method'; then
            log "setDefaultApp is an unknown method here, using setSystemSettings"
            merged_write "$1"
            return $?
        fi
        log "setDefaultApp failed: $out"
        return 1
    fi
    merged_write "$1"
}

# The profile override for webOS 10 and later: awk picks the defaultApps profile out of the
# getProfiles reply, drops its _-prefixed members and sets categories.home.
AWK_OVERRIDE='
function skipstr(s, i,   c) {
    i++
    while (i <= length(s)) {
        c = substr(s, i, 1)
        if (c == "\\") i++
        else if (c == "\"") return i
        i++
    }
    return length(s)
}
function matchend(s, i,   d, c) {
    d = 0
    while (i <= length(s)) {
        c = substr(s, i, 1)
        if (c == "\"") i = skipstr(s, i)
        else if (c == "{" || c == "[") d++
        else if (c == "}" || c == "]") { d--; if (d == 0) return i }
        i++
    }
    return 0
}
function members(obj, K, V,   n, i, j, c, e, key) {
    n = 0
    i = 2
    while (i < length(obj)) {
        c = substr(obj, i, 1)
        if (c == " " || c == "\t" || c == ",") { i++; continue }
        if (c != "\"") break
        j = skipstr(obj, i)
        key = substr(obj, i + 1, j - i - 1)
        i = j + 1
        while (substr(obj, i, 1) == " " || substr(obj, i, 1) == "\t" || substr(obj, i, 1) == ":") i++
        c = substr(obj, i, 1)
        if (c == "{" || c == "[") e = matchend(obj, i)
        else if (c == "\"") e = skipstr(obj, i)
        else {
            e = i
            while (e < length(obj) && substr(obj, e + 1, 1) !~ /[,} \t]/) e++
        }
        n++
        K[n] = key
        V[n] = substr(obj, i, e - i + 1)
        i = e + 1
    }
    return n
}
{ s = s " " $0 }
END {
    p = 1
    found = 0
    while ((q = index(substr(s, p), "\"defaultApps\"")) > 0) {
        pos = p + q - 1
        k = pos + 13
        while (substr(s, k, 1) == " " || substr(s, k, 1) == "\t" || substr(s, k, 1) == ":") k++
        if (substr(s, k, 1) == "{") {
            e = matchend(s, k)
            obj = substr(s, k, e - k + 1)
            if (e > 0 && index(obj, "\"categories\"") > 0) { found = 1; break }
        }
        p = pos + 13
    }
    if (!found) exit 1
    n = members(obj, K, V)
    out = ""
    hascat = 0
    for (i = 1; i <= n; i++) {
        if (substr(K[i], 1, 1) == "_") continue
        v = V[i]
        if (K[i] == "categories" && substr(v, 1, 1) == "{") {
            hascat = 1
            m = members(v, CK, CV)
            v = "{\"home\":\"" home "\""
            for (j = 1; j <= m; j++) if (CK[j] != "home") v = v "," "\"" CK[j] "\":" CV[j]
            v = v "}"
        }
        out = out (out == "" ? "" : ",") "\"" K[i] "\":" v
    }
    if (!hascat) exit 1
    print "{\"defaultApps\":{" out "}}"
}'

override_ok() {
    [ -f "$OVERRIDE" ] || return 1
    esc=$(printf '%s' "$1" | sed 's/\./\\./g')
    tr '\n' ' ' < "$OVERRIDE" | grep -q "\"home\"[[:space:]]*:[[:space:]]*\"$esc\""
}

# check_override <choice>: webOS 10 and later, the override file must exist and name the choice.
check_override() {
    [ "$MAJOR" -ge 10 ] || return 0
    if override_ok "$1"; then
        log "profile override ok"
        return 0
    fi
    log "profile override missing or wrong, rebuilding it"
    out=$(call "$PROFILE/getProfiles" '{"names":["defaultApps"]}' | flatten)
    if ! json=$(printf '%s' "$out" | awk -v home="$1" "$AWK_OVERRIDE") || [ -z "$json" ]; then
        log "getProfiles reply has no defaultApps profile with categories, override not written: $out"
        return 1
    fi
    mkdir -p "$(dirname "$OVERRIDE")" 2>/dev/null
    if printf '%s\n' "$json" > "$OVERRIDE.$$.tmp" && mv "$OVERRIDE.$$.tmp" "$OVERRIDE"; then
        log "wrote $OVERRIDE: $json"
    else
        log "cannot write $OVERRIDE"
        return 1
    fi
    out=$(call "$PROFILE/debug/rescan" '{}' | flatten)
    log "debug/rescan: $out"
}

# The interval before the next write: MIN_INTERVAL doubled once per streak step, capped.
interval() {
    iv=$MIN_INTERVAL
    i=0
    while [ "$i" -lt "$STREAK" ] && [ "$iv" -lt "$BACKOFF_CAP" ]; do
        iv=$((iv * 2))
        i=$((i + 1))
    done
    [ "$iv" -gt "$BACKOFF_CAP" ] && iv=$BACKOFF_CAP
    echo "$iv"
}

# current_home: the record's home, read once more (not from the subscription).
current_home() {
    reply=$(call "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"]}' | flatten)
    home_of "$reply"
}

# reconcile <choice> <found home>: the record does not match; write it again unless a write
# was made less than one interval ago. Then the record is read again (the subscription may be
# showing a stale reply), and if it still does not match, the watcher waits out the interval
# and reads it a last time before writing.
reconcile() {
    want=$1
    found=$2
    t=$(now)
    required=$(interval)
    if [ "$LAST_WRITE" -gt 0 ] && [ $((t - LAST_WRITE)) -lt "$required" ]; then
        found=$(current_home)
        if [ "$found" = "$want" ]; then
            log "home is '$want' again, nothing to write"
            return 0
        fi
        wait_for=$((required - (t - LAST_WRITE)))
        log "home is '${found:-none}', not '$want'; last write was $((t - LAST_WRITE)) s ago, waiting $wait_for s"
        nap "$wait_for"
        want=$(read_choice) || finish "choice file is gone, exiting" 0
        found=$(current_home)
        if [ "$found" = "$want" ]; then
            log "home is '$want' again, nothing to write"
            return 0
        fi
        t=$(now)
    fi
    if [ "$LAST_WRITE" -gt 0 ] && [ $((t - LAST_WRITE)) -lt $((2 * required)) ]; then
        STREAK=$((STREAK + 1))
    else
        STREAK=0
    fi
    LAST_WRITE=$t
    log "home is '${found:-none}', writing '$want' (streak $STREAK, next interval $(interval) s)"
    apply_record "$want"
    check_override "$want"
}

# --- Apps that come and go ---------------------------------------------------------------

# detect_timeout: once, find how `timeout` is called: `timeout SECS CMD` (BusyBox 1.30 and later,
# GNU) or `timeout -t SECS CMD` (BusyBox before 1.30, e.g. 1.29.2 on webOS 5). Sets TMO_FORM to
# new, old or none.
detect_timeout() {
    [ -n "$TMO_FORM" ] && return 0
    TMO_FORM=none
    [ -n "$TIMEOUT" ] && command -v "$TIMEOUT" > /dev/null 2>&1 || return 0
    if "$TIMEOUT" 1 true > /dev/null 2>&1; then
        TMO_FORM=new
    elif "$TIMEOUT" -t 1 true > /dev/null 2>&1; then
        TMO_FORM=old
    fi
}

# timed_n <seconds> <command...>: run a command under a timeout when `timeout` works.
timed_n() {
    secs=$1
    shift
    detect_timeout
    case "$TMO_FORM" in
        new) "$TIMEOUT" "$secs" "$@" ;;
        old) "$TIMEOUT" -t "$secs" "$@" ;;
        *) "$@" ;;
    esac
}

# timed <command...>: run a command under a 10 s timeout when `timeout` works.
timed() {
    timed_n 10 "$@"
}

# --- The stock home's preload policy (webOS 6 and later) -----------------------------------

# close_stock_home: force-close the stock home, only if the policy is still the disabled one.
close_stock_home() {
    [ "$(cat "$TMP/preload" 2>/dev/null)" = off ] || return 0
    # On 6 to 10 sam relaunches it at once as the last-input app (measured 8.3.0, 9.2.1, 10.3.1), for every
    # launcher, so the close frees nothing and it is left running. A reboot ends it: the policy is off from boot.
    # The close sticks on 11 and 12.
    if [ "$MAJOR" -le 10 ]; then
        log "webOS $MAJOR: stock home left running until the next reboot (sam relaunches it as the last-input app)"
        return 0
    fi
    out=$(timed_n 5 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 "$SAM/closeByAppId" "{\"id\":\"$STOCK_HOME\",\"forceMode\":true}" 2>&1 | flatten)
    log "closeByAppId $STOCK_HOME: ${out:-no reply}"
}

# preload_set <true|false>: one setPreloadPolicy call; logs the reply, succeeds on returnValue true.
preload_set() {
    out=$(timed_n 5 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 "$PRELOAD/setPreloadPolicy" "{\"application\":{\"id\":\"$STOCK_HOME\",\"isEnabled\":$1}}" 2>&1 | flatten)
    log "setPreloadPolicy $STOCK_HOME isEnabled=$1: ${out:-no reply}"
    ok_reply "$out"
}

# preload_boot_off: in the background, at a watcher start. The preload manager may not answer yet
# this early in the boot (measured on 9.2.1: the first call timed out), so the call is retried every
# PRELOAD_RETRY seconds, up to PRELOAD_TRIES times; then the boot is given PRELOAD_SETTLE seconds
# and the stock home is closed (if the policy is still disabled by then).
preload_boot_off() {
    trap 'kill "$CP" 2>/dev/null; exit 0' TERM INT HUP
    n=0
    while :; do
        [ "$(cat "$TMP/preload" 2>/dev/null)" = off ] || exit 0
        preload_set false && break
        n=$((n + 1))
        [ "$n" -ge "$PRELOAD_TRIES" ] && exit 0
        $PRELOAD_SLEEP "$PRELOAD_RETRY" &
        CP=$!
        wait "$CP"
    done
    $PRELOAD_SLEEP "$PRELOAD_SETTLE" &
    CP=$!
    wait "$CP"
    close_stock_home
}

# preload_sync <on|off> [start]: bring the stock home's preload policy to the wanted state, once
# per change of state (PRELOAD_STATE starts empty, so once per watcher start too). Never
# "permanent", so the preload manager keeps it in memory only. Whatever happens, the caller goes on.
preload_sync() {
    [ "$PRELOAD_ON" = 1 ] && [ "$MAJOR" -ge 6 ] || return 0
    [ "$PRELOAD_STATE" = "$1" ] && return 0
    if [ "$1" = on ]; then
        flag=true
        # an "on" before anything was changed has nothing to undo, except at a start or an exit
        # (the policy may have been left disabled by an earlier run of the watcher)
        [ -z "$PRELOAD_STATE" ] && [ -z "$2" ] && { PRELOAD_STATE=on; return 0; }
    else
        flag=false
    fi
    PRELOAD_STATE=$1
    echo "$1" > "$TMP/preload" 2>/dev/null
    if [ "$1" = off ] && [ "$2" = start ]; then
        [ -n "$CLOSE_PID" ] && kill "$CLOSE_PID" 2>/dev/null
        preload_boot_off > /dev/null 2>&1 &
        CLOSE_PID=$!
        return 0
    fi
    preload_set "$flag" || return 0
    [ "$1" = off ] && close_stock_home
    return 0
}

# preload_follow <choice> [start]: the stock home is not preloaded while a third-party home is
# chosen and installed.
preload_follow() {
    if [ -n "$MISSING" ] || [ "$1" = "$STOCK_HOME" ] || [ "$1" = "$STOCK_FULLHOME" ]; then
        preload_sync on "$2"
    else
        remember_title "$1"
        preload_sync off "$2"
    fi
}

# --- Telling the user about a removal ---------------------------------------------------------

# remember_title <id>: the chosen app's title, from getAppInfo (failing that its appinfo.json),
# while it is installed; once it is gone it cannot be looked up. Cached per choice in TITLE_ID and
# TITLE_VAL: an installed app without a title is not asked again, a getAppInfo that does not answer is.
remember_title() {
    [ "$NOTIFY_ON" = 1 ] || return 0
    [ "$TITLE_ID" = "$1" ] && return 0
    out=$(timed "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 "$SAM/getAppInfo" "{\"id\":\"$1\"}" 2>&1 | flatten)
    ok_reply "$out" || return 0
    t=$(printf '%s' "$out" | grep -o '"title"[[:space:]]*:[[:space:]]*"[^"\\]*"' | head -n 1 | sed 's/^[^:]*:[[:space:]]*"\(.*\)"$/\1/')
    if [ -z "$t" ]; then
        for d in $APPS_DIRS; do
            [ -f "$d/$1/appinfo.json" ] || continue
            t=$(flatten < "$d/$1/appinfo.json" | grep -o '"title"[[:space:]]*:[[:space:]]*"[^"\\]*"' | head -n 1 | sed 's/^[^:]*:[[:space:]]*"\(.*\)"$/\1/')
            break
        done
    fi
    TITLE_ID=$1
    TITLE_VAL=$(printf '%s' "$t" | tr -d '\000-\037' | sed -e 's/^ *//' -e 's/ *$//')
}

# notify_call <method> <payload>: one call to the notification service with HC_LUNA_IDENTITY.
# A short timeout; the reply is logged and kept in NOTIFY_OUT; succeeds on returnValue true.
notify_call() {
    nc_try=0
    while :; do
        NOTIFY_OUT=$(timed_n 5 "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 "$NOTIF/$1" "$2" 2>&1 | flatten)
        log "notification $1: ${NOTIFY_OUT:-no reply}"
        ok_reply "$NOTIFY_OUT" && return 0
        # A false reply right after the compositor restart ("Alert is blocked by [ system  ui ]",
        # "UI is not yet ready", seen on 9.2.1) is transient: try again for up to NOTIFY_RETRIES
        # times, NOTIFY_RETRY_WAIT seconds apart. No reply at all is not retried.
        printf '%s' "$NOTIFY_OUT" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*false' || return 1
        nc_try=$((nc_try + 1))
        [ "$nc_try" -lt "${NOTIFY_RETRIES:-8}" ] || return 1
        $SLEEP "${NOTIFY_RETRY_WAIT:-3}"
    done
}

# notify_toast <message>: an informational toast. Best effort.
notify_toast() {
    [ "$NOTIFY_ON" = 1 ] || return 0
    notify_call createToast "{\"sourceId\":\"$HC_ID\",\"noaction\":true,\"message\":\"$1\"}" || :
    return 0
}

# notify_alert <message>: an alert with one OK button; a reply that says false (refused) is shown
# as a toast with the same message, and logged. No reply at all is not retried. Best effort.
notify_alert() {
    [ "$NOTIFY_ON" = 1 ] || return 0
    if notify_call createAlert "{\"sourceId\":\"$HC_ID\",\"title\":\"Home Chooser\",\"message\":\"$1\",\"buttons\":[{\"label\":\"OK\",\"focus\":true}]}"; then
        return 0
    fi
    if printf '%s' "$NOTIFY_OUT" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*false'; then
        log "the alert was refused, showing the message as a toast"
        notify_toast "$1"
    fi
    return 0
}

# announce_removed <id>: the chosen app was removed and the stock home is back.
announce_removed() {
    name=$1
    [ "$TITLE_ID" = "$1" ] && [ -n "$TITLE_VAL" ] && name=$TITLE_VAL
    notify_alert "$name was removed, so the Home button opens LG Home again."
}

# app_state <id>: yes (installed), no (getAppInfo answers returnValue false, which is what an
# uninstalled id gets) or unknown (no answer).
app_state() {
    out=$(timed "$LUNA" -a "$HC_LUNA_IDENTITY" -n 1 "$SAM/getAppInfo" "{\"id\":\"$1\"}" 2>&1 | flatten)
    if ok_reply "$out"; then
        echo yes
    elif printf '%s' "$out" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*false'; then
        echo no
    else
        echo unknown
    fi
}

# on_disk <id>: the app's appinfo.json is in one of INSTALL_DIRS, i.e. it is installed even if sam
# does not know it yet.
on_disk() {
    for d in $INSTALL_DIRS; do
        [ -f "$d/$1/appinfo.json" ] && return 0
    done
    return 1
}

# hc_gone: Home Chooser is not installed, by getAppInfo or by its directory.
hc_gone() {
    [ -d "$APPDIR" ] || return 0
    [ "$(app_state "$HC_ID")" = no ]
}

# kf_refresh [stock]: on webOS 6 to 9, bring the id baked into the mounted Settings.qml in line
# (the worker never restarts the compositor here, and does nothing if not mounted).
kf_refresh() {
    [ "$MAJOR" -ge 6 ] && [ "$MAJOR" -le 9 ] || return 0
    [ -f "$KEYFILTER" ] || return 0
    $WSH "$KEYFILTER" refresh $1 >> "$LOG" 2>&1
}

# sync_baked <choice>: the stored choice changed while the app is installed: write it into the
# baked copy without restarting the compositor. The record is read first by the compositor's
# lookup and the watcher has already put the choice there, so the baked id is only the fallback
# for the next compositor start. A choice whose app is not installed (or whose state is unknown)
# is left to check_apps.
sync_baked() {
    [ "$1" = "$BAKED" ] && return 0
    [ "$(app_state "$1")" = yes ] || return 0
    log "choice changed to $1, updating the baked home id"
    kf_refresh
    BAKED=$1
}

# remove_home: write `home` as null in the record, keeping the other entries.
remove_home() {
    reply=$(call "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"]}' | flatten)
    if [ -z "$(home_of "$reply")" ]; then
        log "the record has no home, nothing to remove"
        return 0
    fi
    merged_write "" || return 1
    left=$(current_home)
    if [ -n "$left" ]; then
        log "home is still '$left' after writing it as null"
        return 1
    fi
    log "home cleared (null) in the record"
}

# drop_override: webOS 10 and later, remove our profile override file and rescan.
drop_override() {
    [ "$MAJOR" -ge 10 ] && [ -f "$OVERRIDE" ] || return 0
    rm -f "$OVERRIDE"
    log "removed $OVERRIDE"
    out=$(call "$PROFILE/debug/rescan" '{}' | flatten)
    log "debug/rescan: $out"
}

# revert_platform: put the platform back to stock. Idempotent: it only writes what is not stock.
revert_platform() {
    log "putting the platform back to stock ($1)"
    if [ "$MAJOR" -ge 5 ] && [ "$MAJOR" -le 9 ]; then
        # 5.x: the key filter launches the record's home directly, so name a stock launcher.
        # 6 to 9: the patched QML reads the record first and falls back to the id it loaded at
        # compositor start (the old launcher, until a reboot), so the stock id is written, not
        # null; stock firmware ignores the record for the Home key, so it can stay after an uninstall.
        stock=$STOCK_HOME
        [ "$(app_state "$STOCK_FULLHOME")" = yes ] && stock=$STOCK_FULLHOME
        found=$(current_home)
        if [ "$found" = "$stock" ]; then
            log "home is already $stock"
        else
            merged_write "$stock"
        fi
        return 0
    fi
    drop_override
    remove_home
}

# restore_all: Home Chooser is uninstalled. Everything it did to the platform is undone, from files
# that do not live in the app directory, and the watcher ends.
restore_all() {
    log "Home Chooser is uninstalled, restoring the stock Home"
    if [ -f "$SRC/homechooser-access" ]; then
        $WSH "$SRC/homechooser-access" remove >> "$LOG" 2>&1 || log "could not remove launcher access"
    fi
    revert_platform "Home Chooser uninstalled"
    rm -f "$CHOICE" "$KEYFLAG"
    rmdir "$(dirname "$CHOICE")" 2>/dev/null
    for l in "$INITD" "$OLD_INITD"; do
        if [ -L "$l" ]; then
            rm -f "$l"
            log "removed $l"
        fi
    done
    # No unmount and no compositor restart: the mounts stay until the next boot.
    notify_toast "Home Chooser was removed. The Home button opens LG Home again."
    finish "stock Home restored, exiting" 0
}

# check_hc: Home Chooser is gone, and still gone after the confirmation delay: the full restore.
check_hc() {
    if hc_gone; then
        nap "$CONFIRM_DELAY"
        if hc_gone; then
            restore_all
        fi
        log "Home Chooser is back, not removing anything"
    fi
}

# check_apps <why>: look at Home Chooser and at the chosen app.
check_apps() {
    why=$1
    check_hc
    want=$(read_choice) || finish "choice file is gone, exiting" 0
    [ -n "$MISSING" ] && [ "$MISSING" != "$want" ] && MISSING=
    st=$(app_state "$want")
    if [ "$st" = no ] && [ "$why" = start ] && on_disk "$want"; then
        log "getAppInfo does not know $want yet but its files are installed, leaving things as they are"
        st=unknown
    fi
    case "$st" in
        no)
            if [ "$MISSING" != "$want" ]; then
                nap "$CONFIRM_DELAY"
                # Home Chooser may have been removed while this waited, and its own message
                # may be queued behind this check or never come: look again before acting.
                check_hc
                if [ "$(app_state "$want")" = no ]; then
                    log "$want is not installed, stock Home in use until it comes back"
                    MISSING=$want
                    revert_platform "$want not installed"
                    kf_refresh stock
                    BAKED=
                    [ "$why" = start ] || announce_removed "$want"
                fi
            fi
            ;;
        yes)
            if [ -n "$MISSING" ]; then
                log "$want is installed again, applying the choice"
                MISSING=
                LAST_WRITE=0
                STREAK=0
                if [ "$(current_home)" != "$want" ]; then apply_record "$want"; fi
                check_override "$want"
                kf_refresh
                BAKED=$want
            elif [ "$why" = start ]; then
                kf_refresh
                BAKED=$want
            else
                sync_baked "$want"
            fi
            ;;
        *)
            log "getAppInfo did not answer for $want, leaving things as they are"
            ;;
    esac
    preload_follow "$want" "$why"
    [ -n "$CHECK_MARK" ] && echo "$why" >> "$CHECK_MARK"
    return 0
}

# --- No stored choice: a leftover Home -----------------------------------------------------

# leftover_gone <id>: the id is not installed: getAppInfo says so twice, CONFIRM_DELAY apart, and its
# files are not on disk. Stock ids, an id getAppInfo does not answer for, and an installed one fail.
leftover_gone() {
    case "$1" in "$STOCK_HOME"|"$STOCK_FULLHOME") return 1 ;; esac
    st=$(app_state "$1")
    if [ "$st" = unknown ]; then
        log "getAppInfo did not answer for $1, leaving things as they are"
        return 1
    fi
    [ "$st" = no ] || return 1
    if on_disk "$1"; then
        log "getAppInfo does not know $1 yet but its files are installed, leaving things as they are"
        return 1
    fi
    nap "$CONFIRM_DELAY"
    [ "$(app_state "$1")" = no ] && ! on_disk "$1"
}

# repair_leftover: no usable stored choice. If the record's home (or, on webOS 10 and later, our
# override file's) names an app that is not installed, an earlier Home Chooser was removed or stopped
# while it could not restore: put the platform back to stock the way a removal of the chosen app
# does. Nothing is written for a choice stored while this confirms, and no notification is sent.
repair_leftover() {
    rec=$(current_home)
    ovr=
    if [ "$MAJOR" -ge 10 ] && [ -f "$OVERRIDE" ]; then
        ovr=$(home_of "$(flatten < "$OVERRIDE")")
    fi
    [ -n "$rec$ovr" ] || return 0
    gone_rec=
    gone_ovr=
    [ -n "$rec" ] && leftover_gone "$rec" && gone_rec=$rec
    if [ -n "$ovr" ]; then
        if [ "$ovr" = "$gone_rec" ] || { [ "$ovr" != "$rec" ] && leftover_gone "$ovr"; }; then gone_ovr=$ovr; fi
    fi
    if [ -z "$gone_rec$gone_ovr" ]; then
        log "no stored choice and the home in use is installed or stock, nothing to repair"
        return 0
    fi
    if read_choice > /dev/null; then
        log "a choice was stored meanwhile, not repairing"
        return 0
    fi
    log "no stored choice, but the home names ${gone_rec:-$gone_ovr}, which is not installed: a leftover"
    if [ "$MAJOR" -ge 10 ]; then
        # the record and the override are repaired each on its own: one may name an installed app
        [ -n "$gone_ovr" ] && drop_override
        if [ -n "$gone_rec" ]; then
            if [ "$(current_home)" = "$gone_rec" ]; then remove_home; else log "home changed meanwhile, record left alone"; fi
        fi
    elif [ "$(current_home)" = "$gone_rec" ]; then
        revert_platform "leftover home $gone_rec not installed"
    else
        log "home changed meanwhile, record left alone"
    fi
    kf_refresh stock
}

# handle <reply text>: one complete reply of the settings subscription.
handle() {
    flat=$(printf '%s' "$1" | flatten)
    case "$flat" in
        *'"settings"'*|*'no matched result'*) ;;
        *) return 0 ;;
    esac
    want=$(read_choice) || finish "choice file is gone, exiting" 0
    if [ -n "$MISSING" ]; then
        if [ "$MISSING" = "$want" ]; then return 0; fi
        # the choice was changed to another app while the old one was missing
        MISSING=
        kf_refresh
        BAKED=$want
    fi
    preload_follow "$want"
    sync_baked "$want"
    found=$(home_of "$flat")
    [ "$found" = "$want" ] && return 0
    reconcile "$want" "$found"
}

# feed <tag> <ping>: read a luna-send subscription on stdin, one line per complete reply (its
# braces balance, so both one-line and pretty-printed output work): "<tag> <reply on one line>",
# or just "<tag>" if ping is 1. A last "E <tag>" says the stream ended.
feed() {
    awk -v tag="$1" -v ping="$2" '
        {
            n = gsub(/[{]/, "{"); c = gsub(/[}]/, "}")
            depth += n - c
            buf = buf $0 " "
            if (depth <= 0) {
                if (ping) print tag; else print tag " " buf
                fflush()
                buf = ""
                depth = 0
            }
        }
        END { print "E " tag; fflush() }'
}

# The periodic fallback check: a line "T" every RECHECK seconds.
ticker() {
    trap 'kill "$TP" 2>/dev/null; exit 0' TERM INT HUP
    while :; do
        $TIMER_SLEEP "$RECHECK" &
        TP=$!
        wait "$TP"
        echo T
    done
}

# --- Start ---------------------------------------------------------------------------------

# Run from the copy in the runtime directory, so that the app being removed or replaced cannot
# pull the script out from under the shell.
SRC=$(cd "$(dirname "$0")" && pwd)
RTDIR=$(cd "$RT" 2>/dev/null && pwd)
if [ "$SRC" != "$RTDIR" ]; then
    if stage_runtime "$SRC"; then
        exec $WSH "$RT/homechooser-home-watch"
    fi
    log "cannot copy the scripts to $RT, running from $SRC"
fi
KEYFILTER=$SRC/homechooser-keyfilter

trap 'finish "stopped by signal" 0' TERM INT HUP

MAJOR=$(major_version)
if [ -f "$SRC/homechooser-access" ]; then
    $WSH "$SRC/homechooser-access" apply >> "$LOG" 2>&1 || log "could not apply launcher access"
fi
detect_timeout
LAST_WRITE=0
STREAK=0
LUNA_PID=
NAP_PID=
MISSING=
BAKED=
FEED_PIDS=
CLOSE_PID=
PRELOAD_STATE=
TITLE_ID=
TITLE_VAL=
NOTIFY_OUT=

if ! want=$(read_choice); then
    log "no usable choice file, checking for a leftover home"
    repair_leftover
    want=$(read_choice) || { log "no usable choice file, nothing to watch"; exit 0; }
fi
log "watching, home=$want, webOS $MAJOR"
mkdir -p "$TMP" || exit 1
check_apps start
want=$(read_choice) || finish "choice file is gone, exiting" 0
[ -n "$MISSING" ] || check_override "$want"

mkfifo "$TMP/settings" "$TMP/apps" "$TMP/events" || finish "cannot create the pipes in $TMP" 1
"$LUNA" -a "$HC_LUNA_IDENTITY" -i "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"],"subscribe":true}' > "$TMP/settings" 2>&1 &
LUNA_PID=$!
"$LUNA" -a "$HC_LUNA_IDENTITY" -i "$SAM/listApps" '{"subscribe":true}' > "$TMP/apps" 2>&1 &
LUNA_PID="$LUNA_PID $!"
feed S 0 < "$TMP/settings" > "$TMP/events" &
FEED_PIDS=$!
feed A 1 < "$TMP/apps" > "$TMP/events" &
FEED_PIDS="$FEED_PIDS $!"
ticker > "$TMP/events" &
FEED_PIDS="$FEED_PIDS $!"
exec 3< "$TMP/events"

while IFS= read -r ev <&3; do
    case "$ev" in
        "S "*) handle "${ev#S }" ;;
        A) check_apps apps ;;
        T) check_apps timer ;;
        "E S") finish "subscription ended" 1 ;;
        "E A") log "apps subscription ended, relying on the periodic check" ;;
    esac
done

finish "event stream ended" 1
