#!/bin/sh
# Home Chooser boot entry. /var/lib/webosbrew/init.d/homechooser is a symlink to this file inside
# the installed app; Homebrew Channel's run-parts runs it as root once per boot.
#
#   homechooser         boot: on webOS 6 to 9, when the key filter backport is enabled, apply it
#                     (homechooser-keyfilter); if a home choice is stored, start the watcher
#   homechooser watch   start the watcher now, if a choice is stored and it is not running
#
# The watcher is a transient systemd unit, homechooser-home, made with systemd-run: no unit file
# is written and no other service is touched. The flags used (--unit, --property=Restart,
# --property=RestartSec) exist in systemd 230 and later, which is what is assumed for webOS 5.
# Restart=on-failure, not always: the watcher exits 0 when the choice is removed and has to stay
# stopped then.
#
# The unit runs a small wrapper rather than the script itself: if the app directory is gone when
# the unit restarts (the app was uninstalled after a crash of the watcher), it runs the copy the
# watcher left in /tmp/homechooser-runtime, so the restore to stock still happens; with neither,
# it exits 0 and the unit stays stopped.
#
# The key filter backport is applied here, at boot, because this hook runs after the compositor has
# started (systemd starts it long before devmode's startup.sh); the worker's apply therefore mounts
# and restarts the compositor. The app never does that while the TV runs: it writes the flag and
# asks for a reboot, and this entry applies the patch on that boot. Home Chooser's uninstall removes
# the flag and the link, so nothing re-applies after it.
#
# Files, all under /var/lib/webosbrew/homechooser/: `home` is the stored choice, the app id alone;
# `keyfilter` exists while the backport is enabled.
#
# Overrides, for tests: HOMECHOOSER_DIR (the backport directory), HOMECHOOSER_CHOICE,
# HOMECHOOSER_KEYFILTER_FLAG, HOMECHOOSER_OSRELEASE, HOMECHOOSER_SYSTEMCTL, HOMECHOOSER_SYSTEMD_RUN,
# HOMECHOOSER_LOG.

APP_BACKPORT=/media/developer/apps/usr/palm/applications/org.webosbrew.homechooser/backport
CHOICE=${HOMECHOOSER_CHOICE:-/var/lib/webosbrew/homechooser/home}
FLAG=${HOMECHOOSER_KEYFILTER_FLAG:-/var/lib/webosbrew/homechooser/keyfilter}
OSRELEASE=${HOMECHOOSER_OSRELEASE:-/etc/os-release}
SYSTEMCTL=${HOMECHOOSER_SYSTEMCTL:-systemctl}
SYSTEMD_RUN=${HOMECHOOSER_SYSTEMD_RUN:-systemd-run}
LOG=${HOMECHOOSER_LOG:-/tmp/homechooser-boot.log}
UNIT=homechooser-home
RUNTIME=${HOMECHOOSER_RUNTIME:-/tmp/homechooser-runtime}

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null
}

# The directory this script really lives in: follow the symlink (readlink -f, else one readlink),
# then the fixed app path. Exit quietly when the app is gone.
locate() {
    if [ -n "$HOMECHOOSER_DIR" ]; then
        HERE=$HOMECHOOSER_DIR
    else
        real=$(readlink -f "$0" 2>/dev/null)
        if [ -z "$real" ]; then
            real=$(readlink "$0" 2>/dev/null)
            [ -n "$real" ] || real=$0
        fi
        HERE=$(dirname "$real")
        [ -f "$HERE/homechooser-home-watch" ] || HERE=$APP_BACKPORT
    fi
    if [ ! -f "$HERE/homechooser-home-watch" ] && [ ! -f "$HERE/homechooser-keyfilter" ]; then
        exit 0
    fi
}

major_version() {
    for key in VERSION_ID VERSION PRETTY_NAME; do
        v=$(sed -n "s/^$key=//p" "$OSRELEASE" 2>/dev/null | sed -n 's/[^0-9]*\([0-9][0-9]*\).*/\1/p' | head -n 1)
        if [ -n "$v" ]; then echo "$v"; return 0; fi
    done
    echo 0
}

start_watcher() {
    [ -f "$CHOICE" ] || return 0
    [ -f "$HERE/homechooser-home-watch" ] || { log "no watcher script in $HERE"; return 0; }
    if "$SYSTEMCTL" is-active --quiet "$UNIT"; then
        log "$UNIT is already running"
        return 0
    fi
    "$SYSTEMCTL" reset-failed "$UNIT" 2>/dev/null
    if "$SYSTEMD_RUN" --unit="$UNIT" --property=Restart=on-failure --property=RestartSec=5 \
            /bin/sh -c '[ -f "$1" ] && exec /bin/sh "$1"; [ -f "$2" ] && exec /bin/sh "$2"; exit 0' \
            homechooser-home-watch "$HERE/homechooser-home-watch" "$RUNTIME/homechooser-home-watch" >> "$LOG" 2>&1; then
        log "started $UNIT"
    else
        log "ERROR: could not start $UNIT"
        return 1
    fi
}

locate

case "$1" in
    watch)
        start_watcher
        exit $?
        ;;
    "")
        if [ -f "$HERE/homechooser-access" ]; then
            sh "$HERE/homechooser-access" apply >> "$LOG" 2>&1 || log "could not apply launcher access"
        fi
        major=$(major_version)
        if [ "$major" -ge 6 ] && [ "$major" -le 9 ] && [ -f "$FLAG" ] && [ -f "$HERE/homechooser-keyfilter" ]; then
            log "applying the key filter backport"
            HOMECHOOSER_DATA=$HERE sh "$HERE/homechooser-keyfilter" apply >> "$LOG" 2>&1
        fi
        start_watcher
        ;;
    *)
        echo "usage: $0 [watch]" >&2
        exit 2
        ;;
esac
exit 0
