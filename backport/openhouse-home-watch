#!/bin/sh
# Open House home watcher. Runs as root under the transient unit openhouse-home, started by
# the init.d entry `openhouse` (or by the app). See docs/settings-app.md, "Persistence" and
# "When apps are removed".
#
# It keeps the stored choice (/var/lib/webosbrew/openhouse/home, the app id alone)
# in the general/defaultApps record. It subscribes to the record and, whenever its `home` is
# missing or differs from the choice, writes the choice again:
#   webOS 9 and later  applicationManager/setDefaultApp (setSystemSettings if the method is unknown)
#   webOS 5 to 8       setSystemSettings with the existing entries and home
# On webOS 10 and later it also keeps the system profile override file naming the choice.
#
# It also watches the two apps it depends on. It subscribes to applicationManager/listApps, which
# is only a trigger (the format of the change messages is not relied on), and on every message,
# and every OPENHOUSE_RECHECK seconds (300) as a fallback, asks getAppInfo about the chosen app and
# about org.webosbrew.openhouse:
#   chosen app gone: the platform is put back to stock (webOS 5: home = the stock launcher;
#     6 to 9: `home` written as null and the backport's baked id emptied; 10 and later:
#     override file removed, rescan, `home` written as null), the choice file is kept, and nothing is
#     written while the app is missing. When it is installed again the choice is applied again.
#   Open House gone: the same revert, then the choice file, the backport flag and the init.d link
#     are removed, the backport's bind mounts are undone (webOS 6 to 9) and the watcher exits 0.
# An app is taken as gone only if it is still gone OPENHOUSE_CONFIRM_DELAY seconds (15) later,
# because an update installs by removing first.
#
# The app's files are deleted with the app, so at start the watcher copies itself, the key filter
# worker and the manifests into /tmp/openhouse-runtime/ and runs from there.
#
# Storms: at most one write per interval (10 s); each write that follows the last one closely
# doubles the interval, up to 5 min. Every action is logged to /tmp/openhouse-home.log.
# It exits 0 when the choice file is gone or unusable or after the Open House restore, and 1
# when the settings subscription ends (the unit restarts it on failure).
#
# Overrides, for tests: OPENHOUSE_CHOICE, OPENHOUSE_LUNA_SEND, OPENHOUSE_WATCH_LOG,
# OPENHOUSE_OSRELEASE, OPENHOUSE_OVERRIDE, OPENHOUSE_MIN_INTERVAL, OPENHOUSE_BACKOFF_CAP,
# OPENHOUSE_LOG_MAX, OPENHOUSE_CLOCK (command printing epoch seconds), OPENHOUSE_SLEEP,
# OPENHOUSE_TMP, OPENHOUSE_RUNTIME, OPENHOUSE_SHELL, OPENHOUSE_APPDIR, OPENHOUSE_KEYFILTER_FLAG,
# OPENHOUSE_INITD, OPENHOUSE_RECHECK, OPENHOUSE_TIMER_SLEEP, OPENHOUSE_CONFIRM_DELAY,
# OPENHOUSE_TIMEOUT, OPENHOUSE_CHECK_MARK (file that gets a line after each app check).

CHOICE=${OPENHOUSE_CHOICE:-/var/lib/webosbrew/openhouse/home}
LUNA=${OPENHOUSE_LUNA_SEND:-luna-send}
LOG=${OPENHOUSE_WATCH_LOG:-/tmp/openhouse-home.log}
OSRELEASE=${OPENHOUSE_OSRELEASE:-/etc/os-release}
OVERRIDE=${OPENHOUSE_OVERRIDE:-/var/webos-profile/override/org.webosbrew.openhouse.json}
MIN_INTERVAL=${OPENHOUSE_MIN_INTERVAL:-10}
BACKOFF_CAP=${OPENHOUSE_BACKOFF_CAP:-300}
LOG_MAX=${OPENHOUSE_LOG_MAX:-65536}
CLOCK=${OPENHOUSE_CLOCK:-}
SLEEP=${OPENHOUSE_SLEEP:-sleep}
TMP=${OPENHOUSE_TMP:-/tmp/openhouse-home-watch.$$}
RT=${OPENHOUSE_RUNTIME:-/tmp/openhouse-runtime}
WSH=${OPENHOUSE_SHELL:-/bin/sh}
APPDIR=${OPENHOUSE_APPDIR:-/media/developer/apps/usr/palm/applications/org.webosbrew.openhouse}
KEYFLAG=${OPENHOUSE_KEYFILTER_FLAG:-/var/lib/webosbrew/openhouse/keyfilter}
INITD=${OPENHOUSE_INITD:-/var/lib/webosbrew/init.d/openhouse}
OLD_INITD=$(dirname "$INITD")/openhouse-keyfilter
RECHECK=${OPENHOUSE_RECHECK:-300}
TIMER_SLEEP=${OPENHOUSE_TIMER_SLEEP:-sleep}
CONFIRM_DELAY=${OPENHOUSE_CONFIRM_DELAY:-15}
TIMEOUT=${OPENHOUSE_TIMEOUT-timeout}
TMO_FORM=
CHECK_MARK=${OPENHOUSE_CHECK_MARK:-}
OH_ID=org.webosbrew.openhouse
STOCK_HOME=com.webos.app.home
STOCK_FULLHOME=com.webos.app.fullhome

SETTINGS=luna://com.webos.settingsservice
SAM=luna://com.webos.applicationManager
PROFILE=luna://com.webos.service.systemprofile

now() {
    if [ -n "$CLOCK" ]; then $CLOCK; else date +%s; fi
}

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null
    size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    if [ "$((size + 0))" -gt "$LOG_MAX" ]; then
        tail -n 200 "$LOG" > "$LOG.tmp" 2>/dev/null && mv "$LOG.tmp" "$LOG"
    fi
}

# The major release, from os-release the way the app reads it.
major_version() {
    for key in VERSION_ID VERSION PRETTY_NAME; do
        v=$(sed -n "s/^$key=//p" "$OSRELEASE" 2>/dev/null | sed -n 's/[^0-9]*\([0-9][0-9]*\).*/\1/p' | head -n 1)
        if [ -n "$v" ]; then echo "$v"; return 0; fi
    done
    echo 0
}

# Copy what the removal path needs out of the app directory: this script, the key filter worker
# and the manifests of the diff sets (which name the files the backport mounts over). Each file is
# replaced by rename, so a copy that is running is never rewritten in place.
stage_runtime() {
    mkdir -p "$RT" || return 1
    for f in openhouse-home-watch openhouse-keyfilter; do
        if [ ! -f "$1/$f" ]; then
            [ "$f" = openhouse-keyfilter ] && continue
            return 1
        fi
        cp "$1/$f" "$RT/$f.new" && chmod 755 "$RT/$f.new" && mv "$RT/$f.new" "$RT/$f" || return 1
    done
    for m in "$1"/*/manifest.json; do
        [ -f "$m" ] || continue
        rel=$(basename "$(dirname "$m")")
        mkdir -p "$RT/$rel" && cp "$m" "$RT/$rel/manifest.json" || return 1
    done
}

# read_choice: print the stored home id. The file holds the id alone; surrounding spaces, tabs,
# CR and LF are trimmed. Fails when the file is absent, empty, or holds anything but letters,
# digits, '.', '-' and '_' (the invalid case is logged).
read_choice() {
    [ -f "$CHOICE" ] || return 1
    id=$(tr -d '\r' < "$CHOICE" | tr '\n\t' '  ' | sed -e 's/^ *//' -e 's/ *$//')
    [ -n "$id" ] || return 1
    if printf '%s' "$id" | grep -q '[^A-Za-z0-9._-]'; then
        log "ignoring invalid app id in $CHOICE: '$id'"
        return 1
    fi
    printf '%s' "$id"
}

# call <uri> <payload>: print luna-send's output.
call() {
    "$LUNA" -n 1 "$1" "$2" 2>&1
}

flatten() {
    tr '\n' ' '
}

# home_of <flat reply>: the record's home, or nothing. The record may come as an object or as
# a JSON string (then its quotes are escaped).
home_of() {
    printf '%s' "$1" |
        sed -n 's/.*\\\{0,1\}"home\\\{0,1\}"[[:space:]]*:[[:space:]]*\\\{0,1\}"\([^"\\]*\)\\\{0,1\}".*/\1/p'
}

# record_body <flat reply>: the members of the defaultApps object, without braces. Prints
# nothing and fails when the record is there but not a flat object of members.
record_body() {
    case "$1" in
        *'"defaultApps"'*) ;;
        *) return 0 ;;
    esac
    body=$(printf '%s' "$1" |
        sed -n 's/.*"defaultApps"[[:space:]]*:[[:space:]]*{\([^{}]*\)}.*/\1/p')
    if [ -z "$body" ]; then
        body=$(printf '%s' "$1" |
            sed -n 's/.*"defaultApps"[[:space:]]*:[[:space:]]*"{\([^{}]*\)}".*/\1/p' | sed 's/\\"/"/g')
    fi
    if [ -z "$body" ]; then
        # An empty object is fine; anything else is not understood.
        printf '%s' "$1" | grep -q '"defaultApps"[[:space:]]*:[[:space:]]*"\{0,1\}{[[:space:]]*}' && return 0
        return 1
    fi
    printf '%s' "$body"
}

ok_reply() {
    printf '%s' "$1" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*true'
}

# Pause without blocking signals.
nap() {
    $SLEEP "$1" &
    NAP_PID=$!
    wait "$NAP_PID" 2>/dev/null
    NAP_PID=
}

cleanup() {
    [ -n "$LUNA_PID" ] && kill $LUNA_PID 2>/dev/null
    [ -n "$FEED_PIDS" ] && kill $FEED_PIDS 2>/dev/null
    [ -n "$NAP_PID" ] && kill "$NAP_PID" 2>/dev/null
    rm -rf "$TMP"
}

finish() {
    log "$1"
    cleanup
    exit "${2:-0}"
}

# The merged setSystemSettings write: the existing entries are read back and kept. With an empty
# id `home` is written as null: sub-keys of the record can never be removed (a write without
# `home` only looks like a replace until the settings service restarts), and null reads as unset
# (docs/research/home-key-and-home-app.md, the 11.2.0 / 10.3.1 results).
merged_write() {
    reply=$(call "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"]}' | flatten)
    if ! rest=$(record_body "$reply"); then
        log "cannot read the defaultApps record, not writing: $reply"
        return 1
    fi
    rest=$(printf '%s' "$rest" |
        sed -e 's/"home"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*,//' \
            -e 's/,[[:space:]]*"home"[[:space:]]*:[[:space:]]*"[^"]*"//' \
            -e 's/^[[:space:]]*"home"[[:space:]]*:[[:space:]]*"[^"]*"[[:space:]]*$//' \
            -e 's/"home"[[:space:]]*:[[:space:]]*null[[:space:]]*,//' \
            -e 's/,[[:space:]]*"home"[[:space:]]*:[[:space:]]*null//' \
            -e 's/^[[:space:]]*"home"[[:space:]]*:[[:space:]]*null[[:space:]]*$//')
    rest=$(printf '%s' "$rest" | sed -e 's/^[[:space:]]*,//' -e 's/,[[:space:]]*$//')
    if [ -z "$(printf '%s' "$rest" | tr -d '[:space:]')" ]; then
        if [ -n "$1" ]; then record="{\"home\":\"$1\"}"; else record="{\"home\":null}"; fi
    elif [ -n "$1" ]; then
        record="{\"home\":\"$1\",$rest}"
    else
        record="{\"home\":null,$rest}"
    fi
    out=$(call "$SETTINGS/setSystemSettings" "{\"category\":\"general\",\"settings\":{\"defaultApps\":$record}}" | flatten)
    if ok_reply "$out"; then
        log "setSystemSettings wrote $record"
        return 0
    fi
    log "setSystemSettings failed: $out"
    return 1
}

apply_record() {
    if [ "$MAJOR" -ge 9 ]; then
        out=$(call "$SAM/setDefaultApp" "{\"category\":\"home\",\"appId\":\"$1\"}" | flatten)
        if ok_reply "$out"; then
            log "setDefaultApp home=$1 ok"
            return 0
        fi
        if printf '%s' "$out" | grep -qi 'unknown method'; then
            log "setDefaultApp is an unknown method here, using setSystemSettings"
            merged_write "$1"
            return $?
        fi
        log "setDefaultApp failed: $out"
        return 1
    fi
    merged_write "$1"
}

# The profile override for webOS 10 and later: awk picks the defaultApps profile out of the
# getProfiles reply, drops its _-prefixed members and sets categories.home.
AWK_OVERRIDE='
function skipstr(s, i,   c) {
    i++
    while (i <= length(s)) {
        c = substr(s, i, 1)
        if (c == "\\") i++
        else if (c == "\"") return i
        i++
    }
    return length(s)
}
function matchend(s, i,   d, c) {
    d = 0
    while (i <= length(s)) {
        c = substr(s, i, 1)
        if (c == "\"") i = skipstr(s, i)
        else if (c == "{" || c == "[") d++
        else if (c == "}" || c == "]") { d--; if (d == 0) return i }
        i++
    }
    return 0
}
function members(obj, K, V,   n, i, j, c, e, key) {
    n = 0
    i = 2
    while (i < length(obj)) {
        c = substr(obj, i, 1)
        if (c == " " || c == "\t" || c == ",") { i++; continue }
        if (c != "\"") break
        j = skipstr(obj, i)
        key = substr(obj, i + 1, j - i - 1)
        i = j + 1
        while (substr(obj, i, 1) == " " || substr(obj, i, 1) == "\t" || substr(obj, i, 1) == ":") i++
        c = substr(obj, i, 1)
        if (c == "{" || c == "[") e = matchend(obj, i)
        else if (c == "\"") e = skipstr(obj, i)
        else {
            e = i
            while (e < length(obj) && substr(obj, e + 1, 1) !~ /[,} \t]/) e++
        }
        n++
        K[n] = key
        V[n] = substr(obj, i, e - i + 1)
        i = e + 1
    }
    return n
}
{ s = s " " $0 }
END {
    p = 1
    found = 0
    while ((q = index(substr(s, p), "\"defaultApps\"")) > 0) {
        pos = p + q - 1
        k = pos + 13
        while (substr(s, k, 1) == " " || substr(s, k, 1) == "\t" || substr(s, k, 1) == ":") k++
        if (substr(s, k, 1) == "{") {
            e = matchend(s, k)
            obj = substr(s, k, e - k + 1)
            if (e > 0 && index(obj, "\"categories\"") > 0) { found = 1; break }
        }
        p = pos + 13
    }
    if (!found) exit 1
    n = members(obj, K, V)
    out = ""
    hascat = 0
    for (i = 1; i <= n; i++) {
        if (substr(K[i], 1, 1) == "_") continue
        v = V[i]
        if (K[i] == "categories" && substr(v, 1, 1) == "{") {
            hascat = 1
            m = members(v, CK, CV)
            v = "{\"home\":\"" home "\""
            for (j = 1; j <= m; j++) if (CK[j] != "home") v = v "," "\"" CK[j] "\":" CV[j]
            v = v "}"
        }
        out = out (out == "" ? "" : ",") "\"" K[i] "\":" v
    }
    if (!hascat) exit 1
    print "{\"defaultApps\":{" out "}}"
}'

override_ok() {
    [ -f "$OVERRIDE" ] || return 1
    esc=$(printf '%s' "$1" | sed 's/\./\\./g')
    tr '\n' ' ' < "$OVERRIDE" | grep -q "\"home\"[[:space:]]*:[[:space:]]*\"$esc\""
}

# check_override <choice>: webOS 10 and later, the override file must exist and name the choice.
check_override() {
    [ "$MAJOR" -ge 10 ] || return 0
    if override_ok "$1"; then
        log "profile override ok"
        return 0
    fi
    log "profile override missing or wrong, rebuilding it"
    out=$(call "$PROFILE/getProfiles" '{"names":["defaultApps"]}' | flatten)
    if ! json=$(printf '%s' "$out" | awk -v home="$1" "$AWK_OVERRIDE") || [ -z "$json" ]; then
        log "getProfiles reply has no defaultApps profile with categories, override not written: $out"
        return 1
    fi
    mkdir -p "$(dirname "$OVERRIDE")" 2>/dev/null
    if printf '%s\n' "$json" > "$OVERRIDE.tmp" && mv "$OVERRIDE.tmp" "$OVERRIDE"; then
        log "wrote $OVERRIDE: $json"
    else
        log "cannot write $OVERRIDE"
        return 1
    fi
    out=$(call "$PROFILE/debug/rescan" '{}' | flatten)
    log "debug/rescan: $out"
}

# The interval before the next write: MIN_INTERVAL doubled once per streak step, capped.
interval() {
    iv=$MIN_INTERVAL
    i=0
    while [ "$i" -lt "$STREAK" ] && [ "$iv" -lt "$BACKOFF_CAP" ]; do
        iv=$((iv * 2))
        i=$((i + 1))
    done
    [ "$iv" -gt "$BACKOFF_CAP" ] && iv=$BACKOFF_CAP
    echo "$iv"
}

# current_home: the record's home, read once more (not from the subscription).
current_home() {
    reply=$(call "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"]}' | flatten)
    home_of "$reply"
}

# reconcile <choice> <found home>: the record does not match; write it again unless a write
# was made less than one interval ago. Then the record is read again (the subscription may be
# showing a stale reply), and if it still does not match, the watcher waits out the interval
# and reads it a last time before writing.
reconcile() {
    want=$1
    found=$2
    t=$(now)
    required=$(interval)
    if [ "$LAST_WRITE" -gt 0 ] && [ $((t - LAST_WRITE)) -lt "$required" ]; then
        found=$(current_home)
        if [ "$found" = "$want" ]; then
            log "home is '$want' again, nothing to write"
            return 0
        fi
        wait_for=$((required - (t - LAST_WRITE)))
        log "home is '${found:-none}', not '$want'; last write was $((t - LAST_WRITE)) s ago, waiting $wait_for s"
        nap "$wait_for"
        want=$(read_choice) || finish "choice file is gone, exiting" 0
        found=$(current_home)
        if [ "$found" = "$want" ]; then
            log "home is '$want' again, nothing to write"
            return 0
        fi
        t=$(now)
    fi
    if [ "$LAST_WRITE" -gt 0 ] && [ $((t - LAST_WRITE)) -lt $((2 * required)) ]; then
        STREAK=$((STREAK + 1))
    else
        STREAK=0
    fi
    LAST_WRITE=$t
    log "home is '${found:-none}', writing '$want' (streak $STREAK, next interval $(interval) s)"
    apply_record "$want"
    check_override "$want"
}

# --- Apps that come and go ---------------------------------------------------------------

# detect_timeout: once, find how `timeout` is called: `timeout SECS CMD` (BusyBox 1.30 and later,
# GNU) or `timeout -t SECS CMD` (BusyBox before 1.30, e.g. 1.29.2 on webOS 5). Sets TMO_FORM to
# new, old or none.
detect_timeout() {
    [ -n "$TMO_FORM" ] && return 0
    TMO_FORM=none
    [ -n "$TIMEOUT" ] && command -v "$TIMEOUT" > /dev/null 2>&1 || return 0
    if "$TIMEOUT" 1 true > /dev/null 2>&1; then
        TMO_FORM=new
    elif "$TIMEOUT" -t 1 true > /dev/null 2>&1; then
        TMO_FORM=old
    fi
}

# timed <command...>: run a command under a 10 s timeout when `timeout` works.
timed() {
    detect_timeout
    case "$TMO_FORM" in
        new) "$TIMEOUT" 10 "$@" ;;
        old) "$TIMEOUT" -t 10 "$@" ;;
        *) "$@" ;;
    esac
}

# app_state <id>: yes (installed), no (getAppInfo answers returnValue false, which is what an
# uninstalled id gets) or unknown (no answer).
app_state() {
    out=$(timed "$LUNA" -n 1 "$SAM/getAppInfo" "{\"id\":\"$1\"}" 2>&1 | flatten)
    if ok_reply "$out"; then
        echo yes
    elif printf '%s' "$out" | grep -q '"returnValue"[[:space:]]*:[[:space:]]*false'; then
        echo no
    else
        echo unknown
    fi
}

# oh_gone: Open House is not installed, by getAppInfo or by its directory.
oh_gone() {
    [ -d "$APPDIR" ] || return 0
    [ "$(app_state "$OH_ID")" = no ]
}

# kf_refresh [stock] [norestart]: on webOS 6 to 9, bring the id baked into the mounted Settings.qml
# in line (the worker restarts the compositor only if the id changed, unless told not to, and does
# nothing if not mounted).
kf_refresh() {
    [ "$MAJOR" -ge 6 ] && [ "$MAJOR" -le 9 ] || return 0
    [ -f "$KEYFILTER" ] || return 0
    OPENHOUSE_DATA=$KF_DATA $WSH "$KEYFILTER" refresh $1 >> "$LOG" 2>&1
}

# sync_baked <choice>: the stored choice changed while the app is installed: write it into the
# baked copy without restarting the compositor. The record is read first by the compositor's
# lookup and the watcher has already put the choice there, so the baked id is only the fallback
# for the next compositor start. A choice whose app is not installed (or whose state is unknown)
# is left to check_apps.
sync_baked() {
    [ "$1" = "$BAKED" ] && return 0
    [ "$(app_state "$1")" = yes ] || return 0
    log "choice changed to $1, updating the baked home id"
    kf_refresh norestart
    BAKED=$1
}

# remove_home: write `home` as null in the record, keeping the other entries.
remove_home() {
    reply=$(call "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"]}' | flatten)
    if [ -z "$(home_of "$reply")" ]; then
        log "the record has no home, nothing to remove"
        return 0
    fi
    merged_write "" || return 1
    left=$(current_home)
    if [ -n "$left" ]; then
        log "home is still '$left' after writing it as null"
        return 1
    fi
    log "home cleared (null) in the record"
}

# revert_platform: put the platform back to stock. Idempotent: it only writes what is not stock.
revert_platform() {
    log "putting the platform back to stock ($1)"
    if [ "$MAJOR" -eq 5 ]; then
        # 5.x: the key filter launches the record's home directly, so name a stock launcher.
        stock=$STOCK_HOME
        [ "$(app_state "$STOCK_FULLHOME")" = yes ] && stock=$STOCK_FULLHOME
        found=$(current_home)
        if [ "$found" = "$stock" ]; then
            log "home is already $stock"
        else
            merged_write "$stock"
        fi
        return 0
    fi
    if [ "$MAJOR" -ge 10 ] && [ -f "$OVERRIDE" ]; then
        rm -f "$OVERRIDE"
        log "removed $OVERRIDE"
        out=$(call "$PROFILE/debug/rescan" '{}' | flatten)
        log "debug/rescan: $out"
    fi
    remove_home
}

# restore_all: Open House is uninstalled. Everything it did to the platform is undone, from files
# that do not live in the app directory, and the watcher ends.
restore_all() {
    log "Open House is uninstalled, restoring the stock Home"
    revert_platform "Open House uninstalled"
    rm -f "$CHOICE" "$KEYFLAG"
    rmdir "$(dirname "$CHOICE")" 2>/dev/null
    for l in "$INITD" "$OLD_INITD"; do
        if [ -L "$l" ]; then
            rm -f "$l"
            log "removed $l"
        fi
    done
    if [ "$MAJOR" -ge 6 ] && [ "$MAJOR" -le 9 ] && [ -f "$KEYFILTER" ]; then
        OPENHOUSE_DATA=$KF_DATA $WSH "$KEYFILTER" stop >> "$LOG" 2>&1
    fi
    finish "stock Home restored, exiting" 0
}

# check_apps <why>: look at Open House and at the chosen app.
check_apps() {
    why=$1
    if oh_gone; then
        nap "$CONFIRM_DELAY"
        if oh_gone; then
            restore_all
        fi
        log "Open House is back, not removing anything"
    fi
    want=$(read_choice) || finish "choice file is gone, exiting" 0
    [ -n "$MISSING" ] && [ "$MISSING" != "$want" ] && MISSING=
    st=$(app_state "$want")
    case "$st" in
        no)
            if [ "$MISSING" != "$want" ]; then
                nap "$CONFIRM_DELAY"
                if [ "$(app_state "$want")" = no ]; then
                    log "$want is not installed, stock Home in use until it comes back"
                    MISSING=$want
                    revert_platform "$want not installed"
                    kf_refresh stock
                    BAKED=
                fi
            fi
            ;;
        yes)
            if [ -n "$MISSING" ]; then
                log "$want is installed again, applying the choice"
                MISSING=
                LAST_WRITE=0
                STREAK=0
                if [ "$(current_home)" != "$want" ]; then apply_record "$want"; fi
                check_override "$want"
                kf_refresh
                BAKED=$want
            elif [ "$why" = start ]; then
                kf_refresh
                BAKED=$want
            else
                sync_baked "$want"
            fi
            ;;
        *)
            log "getAppInfo did not answer for $want, leaving things as they are"
            ;;
    esac
    [ -n "$CHECK_MARK" ] && echo "$why" >> "$CHECK_MARK"
    return 0
}

# handle <reply text>: one complete reply of the settings subscription.
handle() {
    flat=$(printf '%s' "$1" | flatten)
    case "$flat" in
        *'"settings"'*|*'no matched result'*) ;;
        *) return 0 ;;
    esac
    want=$(read_choice) || finish "choice file is gone, exiting" 0
    if [ -n "$MISSING" ]; then
        if [ "$MISSING" = "$want" ]; then return 0; fi
        # the choice was changed to another app while the old one was missing
        MISSING=
        kf_refresh
        BAKED=$want
    fi
    sync_baked "$want"
    found=$(home_of "$flat")
    [ "$found" = "$want" ] && return 0
    reconcile "$want" "$found"
}

# feed <tag> <ping>: read a luna-send subscription on stdin, one line per complete reply (its
# braces balance, so both one-line and pretty-printed output work): "<tag> <reply on one line>",
# or just "<tag>" if ping is 1. A last "E <tag>" says the stream ended.
feed() {
    awk -v tag="$1" -v ping="$2" '
        {
            n = gsub(/[{]/, "{"); c = gsub(/[}]/, "}")
            depth += n - c
            buf = buf $0 " "
            if (depth <= 0) {
                if (ping) print tag; else print tag " " buf
                fflush()
                buf = ""
                depth = 0
            }
        }
        END { print "E " tag; fflush() }'
}

# The periodic fallback check: a line "T" every RECHECK seconds.
ticker() {
    trap 'kill "$TP" 2>/dev/null; exit 0' TERM INT HUP
    while :; do
        $TIMER_SLEEP "$RECHECK" &
        TP=$!
        wait "$TP"
        echo T
    done
}

# --- Start ---------------------------------------------------------------------------------

# Run from the copy in the runtime directory, so that the app being removed or replaced cannot
# pull the script out from under the shell.
SRC=$(cd "$(dirname "$0")" && pwd)
RTDIR=$(cd "$RT" 2>/dev/null && pwd)
if [ "$SRC" != "$RTDIR" ]; then
    if stage_runtime "$SRC"; then
        exec $WSH "$RT/openhouse-home-watch"
    fi
    log "cannot copy the scripts to $RT, running from $SRC"
fi
KEYFILTER=$SRC/openhouse-keyfilter
KF_DATA=$SRC

trap 'finish "stopped by signal" 0' TERM INT HUP

MAJOR=$(major_version)
detect_timeout
LAST_WRITE=0
STREAK=0
LUNA_PID=
NAP_PID=
MISSING=
BAKED=
FEED_PIDS=

want=$(read_choice) || { log "no usable choice file, nothing to watch"; exit 0; }
log "watching, home=$want, webOS $MAJOR"
mkdir -p "$TMP" || exit 1
check_apps start
want=$(read_choice) || finish "choice file is gone, exiting" 0
[ -n "$MISSING" ] || check_override "$want"

mkfifo "$TMP/settings" "$TMP/apps" "$TMP/events" || finish "cannot create the pipes in $TMP" 1
"$LUNA" -i "$SETTINGS/getSystemSettings" '{"category":"general","keys":["defaultApps"],"subscribe":true}' > "$TMP/settings" 2>&1 &
LUNA_PID=$!
"$LUNA" -i "$SAM/listApps" '{"subscribe":true}' > "$TMP/apps" 2>&1 &
LUNA_PID="$LUNA_PID $!"
feed S 0 < "$TMP/settings" > "$TMP/events" &
FEED_PIDS=$!
feed A 1 < "$TMP/apps" > "$TMP/events" &
FEED_PIDS="$FEED_PIDS $!"
ticker > "$TMP/events" &
FEED_PIDS="$FEED_PIDS $!"
exec 3< "$TMP/events"

while IFS= read -r ev <&3; do
    case "$ev" in
        "S "*) handle "${ev#S }" ;;
        A) check_apps apps ;;
        T) check_apps timer ;;
        "E S") finish "subscription ended" 1 ;;
        "E A") log "apps subscription ended, relying on the periodic check" ;;
    esac
done

finish "event stream ended" 1
